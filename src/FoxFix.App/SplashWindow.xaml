<Window x:Class="FoxFix.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoxFix.App"
        Title="FoxFix" Width="460" Height="300" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Topmost="True" WindowStartupLocation="CenterScreen" Icon="Assets/FoxFix.ico"
        Background="Transparent" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
    <Window.Resources>
        <!-- A thin rounded bar: the track and the fill have round ends -->
        <Style x:Key="RoundedBar" TargetType="ProgressBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Border CornerRadius="2" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Track">
                                <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="2" Background="{TemplateBinding Foreground}" />
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <!-- Round corners and a faint outline in the accent colour; the margin leaves room for the soft shadow -->
    <Border Margin="14" CornerRadius="22" Background="{DynamicResource Background}" BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
        </Border.Effect>
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="Logo" Source="{DynamicResource FoxLogoImage}" Height="118" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="FoxFix" FontFamily="{StaticResource DisplayFont}" FontSize="28" FontWeight="SemiBold"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock x:Name="SubtitleText" Visibility="Collapsed" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <ProgressBar x:Name="Bar" Style="{StaticResource RoundedBar}" Minimum="0" Maximum="1" Value="0" Width="160" Height="4" Margin="0,22,0,0"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>