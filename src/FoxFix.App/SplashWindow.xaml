<Window x:Class="FoxFix.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxFix" Width="440" Height="280" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="CenterScreen" Icon="Assets/FoxFix.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image Source="Assets/FoxLogo.png" Height="118" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" />
                <TextBlock Text="FoxFix" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <ProgressBar IsIndeterminate="True" Width="120" Height="3" Margin="0,22,0,0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>