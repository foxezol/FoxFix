<Window x:Class="FoxFix.App.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxFix" Width="440" Height="280" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Topmost="True" WindowStartupLocation="CenterScreen" Icon="Assets/FoxFix.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Display">
    <Border BorderBrush="{DynamicResource Divider}" BorderThickness="1">
        <Grid>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <Image x:Name="Logo" Source="Assets/FoxLogo.png" Height="118" RenderOptions.BitmapScalingMode="HighQuality"
                       HorizontalAlignment="Center" />
                <TextBlock x:Name="TitleText" Text="FoxFix" FontFamily="{StaticResource DisplayFont}" FontSize="26" FontWeight="Bold"
                           HorizontalAlignment="Center" Margin="0,18,0,0" />
                <TextBlock x:Name="SubtitleText" Visibility="Collapsed" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                <ProgressBar x:Name="Bar" Minimum="0" Maximum="1" Value="0" Width="160" Height="3" Margin="0,22,0,0"
                             Foreground="{DynamicResource Accent}" Background="{DynamicResource Divider}" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>