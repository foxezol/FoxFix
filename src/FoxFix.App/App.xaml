<Application x:Class="FoxFix.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:FoxFix.App">
    <Application.Resources>
        <!-- ================================================================================================
             FoxFix design system (0.10)

             Colour   Ink-slate surfaces; the accent is spent only on actions, the current page, focus and selection.
                      ThemeManager (Theme.cs) replaces every brush below at startup and when the theme changes,
                      so all references are DynamicResource.
             Type     Bahnschrift (ships with Windows) for page titles and measurements: the "instrument" voice.
                      Segoe UI Variable for everything that is read.
                      Scale: 28 page title / 17 section / 14 body / 12.5 caption.
             Space    4-px grid. Page edge 36, panel padding 20, between panels 16, inside a panel 12.
             Radius   12 panels and pop-ups, 8 controls, 6 small marks. Nothing else is rounded.
             State    Never colour alone: every status has a word, and most a drawn symbol.
             ================================================================================================ -->

        <SolidColorBrush x:Key="Background" Color="#10131A" />
        <SolidColorBrush x:Key="Card" Color="#181C25" />
        <SolidColorBrush x:Key="Divider" Color="#2A303D" />
        <SolidColorBrush x:Key="Foreground" Color="#E9EDF4" />
        <SolidColorBrush x:Key="Muted" Color="#9AA3B5" />
        <SolidColorBrush x:Key="ButtonSecondary" Color="#232835" />
        <SolidColorBrush x:Key="Raised" Color="#2B3140" />
        <SolidColorBrush x:Key="Accent" Color="#9E20E6" />
        <SolidColorBrush x:Key="AccentText" Color="#C58AF9" />
        <!-- The label on an accent-coloured button: white or black, whichever reads better on the chosen colour. -->
        <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="AccentSoft" Color="#2B1F3C" />
        <SolidColorBrush x:Key="StatusOk" Color="#3DD68C" />
        <SolidColorBrush x:Key="StatusWarn" Color="#F5B946" />
        <SolidColorBrush x:Key="StatusBad" Color="#FF7A70" />
        <SolidColorBrush x:Key="StatusNeutral" Color="#9AA3B5" />
        <SolidColorBrush x:Key="OkSoft" Color="#1A2F2C" />
        <SolidColorBrush x:Key="WarnSoft" Color="#33302A" />
        <SolidColorBrush x:Key="BadSoft" Color="#332631" />
        <!-- The dimmed window behind a pop-up -->
        <SolidColorBrush x:Key="Scrim" Color="#A6000000" />

        <!-- The fox logo; ThemeManager swaps it for a copy painted in the accent colour when the person asked for that. -->
        <BitmapImage x:Key="FoxLogoImage" UriSource="Assets/FoxLogo.png" />
        <BitmapImage x:Key="FoxIconImage" UriSource="Assets/FoxFix.ico" />
        <BitmapImage x:Key="FoxDpiLogoImage" UriSource="Assets/FoxDpiLogo.png" />
        <BitmapImage x:Key="FoxDpiIconImage" UriSource="Assets/FoxDpi.ico" />

        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <local:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
        <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
        <FontFamily x:Key="NumberFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>

        <!-- Keyboard focus: a 2-px ring outside the control, in the accent text colour. WPF draws a FocusVisualStyle only when
             focus came from the keyboard, so a mouse click never leaves a ring behind. -->
        <Style x:Key="FocusRing">
            <Setter Property="Control.Template">
                <Setter.Value>
                    <ControlTemplate>
                        <Border Margin="-3" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource AccentText}" SnapsToDevicePixels="True" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ TEXT ============ -->

        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe UI Variable Display, Segoe UI" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="BodyMuted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="21" />
        </Style>

        <!-- Small print under a control: what it does, what it costs -->
        <Style x:Key="Caption" TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="LineHeight" Value="19" />
        </Style>

        <!-- Measurements: download, upload, ping -->
        <Style x:Key="Reading" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
        </Style>

        <!-- ============ SURFACES ============ -->

        <!-- A group of things that belong together. Used for groups, not for every line. -->
        <Style x:Key="Panel" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="20,18" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- A note that matters on this page: tinted, no border, in the accent colour -->
        <Style x:Key="Callout" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="Margin" Value="0,16,0,0" />
        </Style>

        <!-- A caution that is not an error (anti-cheat, data use) -->
        <Style x:Key="CalloutWarn" TargetType="Border" BasedOn="{StaticResource Callout}">
            <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
        </Style>

        <!-- Kept for older markup: same look as a panel -->
        <Style x:Key="Sheet" TargetType="Border" BasedOn="{StaticResource Panel}" />

        <Style x:Key="Section" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,28,0,0" />
        </Style>

        <Style x:Key="Hairline" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
            <Setter Property="Margin" Value="0,16" />
        </Style>

        <!-- The card of a pop-up -->
        <Style x:Key="DialogCard" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="26,24" />
            <Setter Property="Margin" Value="24" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity="0.35" Color="#000000" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ BUTTONS ============
             One shape for all: 8-px corners, a keyboard focus ring that sits outside the button (2 px, accent text colour),
             a slight lift on hover, a slight press. Primary = the one action of a screen; Secondary = the rest;
             Ghost = links out of the app; Danger = the one thing that cannot be undone. -->
        <ControlTemplate x:Key="RoundedButton" TargetType="Button">
            <Grid SnapsToDevicePixels="True">
                
                <Border x:Name="Chrome" CornerRadius="8" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        RenderTransformOrigin="0.5,0.5">
                    <Grid>
                        <Border x:Name="Lift" CornerRadius="7" Background="{DynamicResource Foreground}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          RecognizesAccessKey="True" />
                    </Grid>
                </Border>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Lift" Property="Opacity" Value="0.07" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter TargetName="Lift" Property="Opacity" Value="0.12" />
                    <Setter TargetName="Chrome" Property="RenderTransform">
                        <Setter.Value>
                            <ScaleTransform ScaleX="0.98" ScaleY="0.98" />
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource RoundedButton}" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="{DynamicResource Accent}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentForeground}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        </Style>

        <!-- The one big action of the overview -->
        <Style x:Key="HeroButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Padding" Value="26,11" />
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="FontSize" Value="15.5" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="{DynamicResource ButtonSecondary}" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Padding" Value="15,8" />
        </Style>

        <!-- Small buttons inside a row (Geri aç, Sil, Geri yükle) -->
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>

        <!-- Links out of the app: no fill until pointed at -->
        <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="32" />
        </Style>

        <!-- A plain link in running text: accent-coloured words, underlined when pointed at; no box -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent" Padding="0,2">
                            <TextBlock x:Name="Text" Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- For what cannot be undone: an outline in the theme's red, filled only when pointed at -->
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Background" Value="{DynamicResource BadSoft}" />
            <Setter Property="BorderBrush" Value="{DynamicResource StatusBad}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusBad}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- A small hit area around an icon -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="Transparent" CornerRadius="8" Padding="7" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="{DynamicResource ButtonSecondary}" />
                                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The title line of a folding list: the whole line is the button -->
        <Style x:Key="FoldHeader" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Hit" Background="Transparent" CornerRadius="8" Padding="10,11" BorderThickness="2" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hit" Property="Background" Value="{DynamicResource ButtonSecondary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ============ NAVIGATION ============
             The current page: tinted pill and a 3-px accent mark at its left edge. The icon is the page's own sign;
             it is passed in through Tag-free content (a Path in the button). -->
        <Style x:Key="NavItem" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border x:Name="Bar" Background="Transparent" BorderBrush="Transparent" BorderThickness="2"
                                    CornerRadius="8" Padding="12,8" MinHeight="38">
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <Border x:Name="Mark" Width="3" Height="18" CornerRadius="1.5" Background="{DynamicResource AccentText}"
                                    HorizontalAlignment="Left" VerticalAlignment="Center" Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ButtonSecondary}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource AccentSoft}" />
                                <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                                <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The page's sign in the menu: a 16-px line drawing in the text colour of its button -->
        <Style x:Key="NavIcon" TargetType="Path">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="StrokeThickness" Value="1.5" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Style>

        <!-- ============ STATUS ============ -->

        <!-- Status colours follow the theme; the view model only says which kind a row is -->
        <Style x:Key="StatusDot" TargetType="Border">
            <Setter Property="BorderBrush" Value="{DynamicResource StatusNeutral}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Ok">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusOk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bad">
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The symbol is a drawn path on a 16x16 grid, so it always sits inside its circle -->
        <Style x:Key="StatusPath" TargetType="Path">
            <Setter Property="Stroke" Value="{DynamicResource StatusNeutral}" />
            <Setter Property="StrokeThickness" Value="1.9" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Ok">
                    <Setter Property="Stroke" Value="{DynamicResource StatusOk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn">
                    <Setter Property="Stroke" Value="{DynamicResource StatusWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bad">
                    <Setter Property="Stroke" Value="{DynamicResource StatusBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A small status mark next to a word: the colour of the row's Kind -->
        <Style x:Key="KindDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource StatusNeutral}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource StatusOk}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource StatusWarn}" /></DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Bad"><Setter Property="Fill" Value="{DynamicResource StatusBad}" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="VerdictBar" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusNeutral}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource StatusOk}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Attention">
                    <Setter Property="Background" Value="{DynamicResource StatusWarn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Problem">
                    <Setter Property="Background" Value="{DynamicResource StatusBad}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="Failed">
                    <Setter Property="Background" Value="{DynamicResource StatusBad}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The surface behind the verdict: a plain panel. The status dot, the symbols on the line and the words carry
             the meaning; a tinted band made the whole screen look muddy when there was only a small thing to look at. -->
        <Style x:Key="VerdictBand" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Card}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>

        <!-- Kept for older markup -->
        <ControlTemplate x:Key="TileTemplate" TargetType="Button">
            <Border x:Name="Tile" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}"
                    BorderThickness="1" CornerRadius="12" Padding="18,16" SnapsToDevicePixels="True">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Top" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource TileTemplate}" />
            <Setter Property="Margin" Value="0,0,12,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
        </Style>

        <!-- ============ INPUTS ============ -->

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Foreground}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{DynamicResource Background}" BorderBrush="{DynamicResource Divider}"
                                BorderThickness="1" CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentText}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Frame" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="18" Height="18" VerticalAlignment="Top" Margin="0,1,0,0">
                                
                                <Ellipse x:Name="Ring" Stroke="{DynamicResource Muted}" StrokeThickness="1.6" />
                                <Ellipse x:Name="Dot" Fill="{DynamicResource Accent}" Margin="4.5" Visibility="Collapsed" />
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Foreground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Check box: a rounded square that fills with the accent when ticked -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="Margin" Value="0,12,0,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRing}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid VerticalAlignment="Top" Margin="0,1,0,0">
                                
                                <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5"
                                        BorderBrush="{DynamicResource Muted}" Background="Transparent">
                                    <Path x:Name="Tick" Data="M1,5 L4,8 L10,1" Width="10" Height="8" Stretch="Uniform"
                                          Stroke="{DynamicResource AccentForeground}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                                </Border>
                            </Grid>
                            <ContentPresenter x:Name="Label" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Foreground}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <!-- Disabled: the box fades a lot, the words only a little, so they stay readable -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Box" Property="Opacity" Value="0.4" />
                                <Setter TargetName="Label" Property="Opacity" Value="0.78" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A section that opens on click: header row with a chevron, flat content below -->
        <Style x:Key="FoldSection" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="Margin" Value="0,10,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton x:Name="Header" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Cursor="Hand" FocusVisualStyle="{StaticResource FocusRing}"
                                          AutomationProperties.Name="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bar" Background="{DynamicResource Background}" BorderBrush="{DynamicResource Divider}"
                                                BorderThickness="1" CornerRadius="8" Padding="14,10">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter VerticalAlignment="Center" />
                                                <Path x:Name="Chevron" Grid.Column="1" Data="M 1,3 L 6,8 L 11,3" Stroke="{DynamicResource Muted}"
                                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource ButtonSecondary}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header" TextElement.FontWeight="SemiBold" TextElement.FontSize="14"
                                                  TextElement.Foreground="{DynamicResource Foreground}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Visibility="Collapsed" Margin="4,4,0,4" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Body" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" FillBehavior="Stop" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Raised}" />
            <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="6" Padding="9,5">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Thin scroll bar: only a rounded thumb, brighter on hover -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Pill" CornerRadius="4" Background="{DynamicResource Divider}" Margin="3" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <ControlTemplate x:Key="VerticalScrollBarTemplate" TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate" TargetType="ScrollBar">
            <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource ScrollThumb}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" Focusable="False" IsTabStop="False" />
                </Track.IncreaseRepeatButton>
            </Track>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Template" Value="{StaticResource VerticalScrollBarTemplate}" />
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="12" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarTemplate}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Progress bar: a slim rounded track; the moving kind is a short bar sliding across -->
        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="4" />
            <Setter Property="Background" Value="{DynamicResource Divider}" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid x:Name="Root" ClipToBounds="True">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Determinate" />
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard RepeatBehavior="Forever">
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Indicator" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Slider" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                                            </ObjectAnimationUsingKeyFrames>
                                            <DoubleAnimation Storyboard.TargetName="Slide" Storyboard.TargetProperty="X"
                                                             From="-160" To="1400" Duration="0:0:1.6" />
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="PART_Track" CornerRadius="2" Background="{TemplateBinding Background}" />
                            <Border x:Name="PART_Indicator" CornerRadius="2" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" />
                            <Border x:Name="Slider" CornerRadius="2" Width="160" HorizontalAlignment="Left" Visibility="Collapsed"
                                    Background="{TemplateBinding Foreground}">
                                <Border.RenderTransform>
                                    <TranslateTransform x:Name="Slide" />
                                </Border.RenderTransform>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
