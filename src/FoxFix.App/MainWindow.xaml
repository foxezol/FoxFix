                <Border Height="1" Background="{DynamicResource Divider}" Margin="0,22,0,0" />
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="made by foxezol w Claude Code" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource IconButton}"
