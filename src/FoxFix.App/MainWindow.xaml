    <!-- ============ "BENİ DÜZELT" PICKER (pop-up) ============ -->
    <Grid Grid.ColumnSpan="2" Visibility="{Binding RepairPicker.IsOpen, Converter={StaticResource BoolToVis}}"
          IsVisibleChanged="OnDialogVisibleChanged">
        <Border Background="#99000000" MouseDown="OnPickerBackdropMouseDown" />
        <Border Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="1" CornerRadius="16"
                Padding="24" MaxWidth="560" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="600">
                <StackPanel>
                    <TextBlock Text="Neleri düzeltelim?" Style="{StaticResource SectionTitle}" FontSize="22" />
                    <TextBlock Style="{StaticResource BodyMuted}" Margin="0,6,0,0"
                               Text="İstediklerini işaretle. Önizlemede ne değişeceğini görürsün, sen onaylamadan hiçbir şey yapılmaz." />

                    <TextBlock Text="İnternet" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="0,20,0,0" />
                    <CheckBox IsChecked="{Binding RepairPicker.IncludeDpi}" AutomationProperties.Name="Eski DPI araçlarını temizle">
                        <StackPanel>
                            <TextBlock Text="Eski DPI araçlarını temizle" />
                            <TextBlock Style="{StaticResource BodyMuted}" FontSize="12"
                                       Text="GoodbyeDPI, WinDivert ve Zapret kalıntıları. Kendi kullandığın GoodbyeDPI da silinir, önizlemede görürsün." />
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding RepairPicker.IncludeDns}" AutomationProperties.Name="DNS ayarını onar">
                        <StackPanel>
                            <TextBlock Text="DNS ayarını onar" />
                            <TextBlock Style="{StaticResource BodyMuted}" FontSize="12"
                                       Text="Çalışmayan DNS'i otomatiğe (modemden) alır. Eski ayar kaydedilir." />
                        </StackPanel>
                    </CheckBox>

                    <TextBlock Text="Bilgisayar" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" Margin="0,22,0,0" />
                    <CheckBox IsChecked="{Binding RepairPicker.IncludeStartup}" IsEnabled="{Binding RepairPicker.StartupAvailable}"
                              AutomationProperties.Name="Açılış programı değişiklikleri">
                        <TextBlock Text="{Binding RepairPicker.StartupText}" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Text="{Binding RepairPicker.CleanupText}" Margin="0,14,0,0" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding RepairPicker.Cleanup.Items}" Margin="0,0,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Title}" Margin="0"
                                              AutomationProperties.Name="{Binding Title}" />
                                    <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button Content="Önizlemeyi göster" Command="{Binding RepairPicker.ContinueCommand}"
                                Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Önizlemeyi göster" />
                        <Button Content="Vazgeç" Command="{Binding RepairPicker.CloseCommand}"
                                Style="{StaticResource SecondaryButton}" AutomationProperties.Name="Vazgeç" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
    </Grid>
</Window>
