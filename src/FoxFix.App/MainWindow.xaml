                Padding="26" MaxWidth="460" Margin="24" VerticalAlignment="Center" HorizontalAlignment="Center"
                RenderTransformOrigin="0.5,0.5">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Image Source="Assets/FoxLogo.png" Height="44" RenderOptions.BitmapScalingMode="HighQuality" />
