<Window x:Class="FoxFix.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoxFix.App"
        Title="FoxFix" Height="780" Width="1000" MinWidth="780" MinHeight="540"
        Icon="Assets/FoxFix.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- The slider for the colour wheel's brightness: a 6 px track filled with the accent colour and a round thumb -->
        <Style x:Key="BrightnessSlider" TargetType="Slider">
            <Setter Property="Height" Value="24" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent" SnapsToDevicePixels="True">
                            <Border Height="6" CornerRadius="3" Background="{DynamicResource Divider}" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" CornerRadius="3" Background="{DynamicResource Accent}" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="6" Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Focusable="True">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="{DynamicResource Foreground}" Stroke="{DynamicResource Accent}" StrokeThickness="2" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                                        <Setter TargetName="Knob" Property="Stroke" Value="{DynamicResource AccentText}" />
                                                        <Setter TargetName="Knob" Property="StrokeThickness" Value="3" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- The last circle after the ready-made colours: the wheel itself; ringed when a custom colour is in use or the panel is open -->
        <Style x:Key="WheelSwatch" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Halo" StrokeThickness="2" Stroke="Transparent" />
                            <Ellipse Margin="5">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{x:Static local:ColorWheel.SharedWheel}" Stretch="Fill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse x:Name="Dot" Width="12" Height="12" Fill="{DynamicResource Accent}" Stroke="{DynamicResource Background}" StrokeThickness="2"
                                     Visibility="{Binding DataContext.Settings.IsCustomAccent, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Halo" Property="Stroke" Value="{DynamicResource Muted}" /></Trigger>
                            <DataTrigger Binding="{Binding DataContext.Settings.CustomSwatchSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                <Setter TargetName="Halo" Property="Stroke" Value="{DynamicResource Foreground}" />
                            </DataTrigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Halo" Property="Stroke" Value="{DynamicResource AccentText}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid x:Name="WindowFrame">
    <Grid.RowDefinitions>
        <RowDefinition Height="0" />
        <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions>
        <ColumnDefinition Width="0" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <ScrollViewer x:Name="Scroller" Grid.Column="1" Margin="232,38,0,0" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="PageHost" MaxWidth="760" Margin="36,8,36,36">
            <StackPanel.RenderTransform>
                <TranslateTransform />
            </StackPanel.RenderTransform>

            <!-- Page header: title and one line on what the page is for (not on the overview, whose verdict is its title) -->
            <StackPanel Visibility="{Binding ShowBack, Converter={StaticResource BoolToVis}}" Margin="0,0,0,8">
                <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageTitle}" AutomationProperties.LiveSetting="Polite"
                           AutomationProperties.HeadingLevel="Level1" />
                <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource BodyMuted}" Margin="0,6,0,0" />
            </StackPanel>

            <!-- Short messages; changes, restarts and results open as pop-ups in the middle of the window (below) -->
            <Border Style="{StaticResource Callout}" Margin="0,8,0,0" Visibility="{Binding HasStatusText, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>

            <!-- ============ HOME ============ -->
            <StackPanel Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}">

                <!-- After a repair: what the repair changed, set against the check from before it -->
                <Border Style="{StaticResource Callout}" Margin="0,0,0,12" Visibility="{Binding HasComparison, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{local:T CompareTitle}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ComparisonText}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- The verdict and the line from this computer to the internet: the one thing this screen is about.
                     The band takes the verdict's colour, quietly; the words and the symbols carry the meaning. -->
                <Border Style="{StaticResource VerdictBand}" BorderThickness="1" CornerRadius="12" Padding="24,22,24,24">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource VerdictBar}" Width="12" Height="12" CornerRadius="6"
                                    VerticalAlignment="Top" Margin="0,13,14,0" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding VerdictTitle}" Style="{StaticResource PageTitle}"
                                           AutomationProperties.LiveSetting="Polite" AutomationProperties.HeadingLevel="Level1" />
                                <TextBlock Text="{Binding VerdictDetail}" TextWrapping="Wrap" LineHeight="21" Margin="0,6,0,0"
                                           Foreground="{DynamicResource Foreground}" Opacity="0.82" />
                                <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiagnosisPercent}" Height="4"
                                                 AutomationProperties.Name="{local:T UiKontrolIlerlemesi}" />
                                    <TextBlock Text="{Binding DiagnosisProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                                </StackPanel>
                                <WrapPanel Margin="0,18,0,0">
                                    <Button x:Name="TourFixButton" Content="{local:T UiBeniDuzelt}" Command="{Binding RepairPicker.OpenCommand}" IsEnabled="{Binding IsIdle}"
                                            Style="{StaticResource HeroButton}" AutomationProperties.Name="{local:T UiBeniDuzelt}"
                                            ToolTip="{local:T UiOnceNeyinDegiseceginiSecersinizVeO}" />
                                    <Button Content="{local:T UiYenidenKontrolEt}" Command="{Binding RunDiagnosticsCommand}"
                                            Style="{StaticResource SecondaryButton}" MinHeight="44" AutomationProperties.Name="{local:T UiYenidenKontrolEt}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- The line itself: each layer is a stop on the way out, so the order means something -->
                        <StackPanel Margin="0,24,0,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                            <Border Height="1" Background="{DynamicResource Divider}" Margin="0,0,0,18" Opacity="0.7" />
                            <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                                <!-- Fixed-width stops: in a narrow window the line continues on a second row instead of breaking words -->
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel ItemWidth="100" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <Grid.RenderTransform>
                                                <TranslateTransform />
                                            </Grid.RenderTransform>
                                            <Grid.Triggers>
                                                <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.28" />
                                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)"
                                                                             From="-6" To="0" Duration="0:0:0.28">
                                                                <DoubleAnimation.EasingFunction>
                                                                    <CubicEase EasingMode="EaseOut" />
                                                                </DoubleAnimation.EasingFunction>
                                                            </DoubleAnimation>
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </EventTrigger>
                                            </Grid.Triggers>
                                            <!-- The wire to the next stop -->
                                            <Rectangle Height="2" Fill="{DynamicResource Divider}" VerticalAlignment="Top" Margin="30,15,6,0" />
                                            <StackPanel Margin="0,0,8,0">
                                                <Border Style="{StaticResource StatusDot}" Width="32" Height="32" CornerRadius="16"
                                                        HorizontalAlignment="Left" Background="{DynamicResource Card}" BorderThickness="2"
                                                        AutomationProperties.Name="{Binding StatusLabel}">
                                                    <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Canvas Width="16" Height="16">
                                                            <Path Style="{StaticResource StatusPath}" Data="{Binding Icon}" />
                                                        </Canvas>
                                                    </Viewbox>
                                                </Border>
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" Margin="0,10,0,0" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{local:T UiAyrintilariGoster}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Connection}"
                                    Style="{StaticResource GhostButton}" HorizontalAlignment="Left" Margin="-10,14,0,0"
                                    AutomationProperties.Name="{local:T UiBaglantiKontrolununAyrintilariniGo}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- FoxDPI: its state in words, one action. It is closed by closing its own window, so there is no stop here -->
                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Image Source="{DynamicResource FoxDpiLogoImage}" Height="38" Margin="0,0,14,0" RenderOptions.BitmapScalingMode="HighQuality"
                                   AutomationProperties.Name="{local:T UiFoxdpiLogosu}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="FoxDPI" Style="{StaticResource SectionTitle}" />
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource StatusNeutral}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dpi.IsActive}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource StatusOk}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                    <TextBlock AutomationProperties.LiveSetting="Polite">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                                                <Setter Property="Text" Value="{local:T UiDpiOffDirect}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Dpi.IsActive}" Value="True">
                                                        <Setter Property="Text" Value="{local:T UiDpiOnBypassing}" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Foreground}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding Dpi.FoxDpiButtonText}" Command="{Binding Dpi.ToggleFoxDpiCommand}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiFoxdpiYiBaslatYaDaPenceresini}" />
                            <Button Content="{local:T UiDpiAyarlari}" Command="{Binding OpenPageCommand}"
                                    CommandParameter="{x:Static local:AppPage.DnsDpi}" Style="{StaticResource SecondaryButton}"
                                    Margin="0" AutomationProperties.Name="{local:T UiDpiAyarlari}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Speed: the numbers, as type -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T UiBaglantiHizi}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="{local:T UiHizTestiniBaslat}" Command="{Binding Speed.StartCommand}"
                                        Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiHizTestiniBaslat}" />
                                <Button Content="{local:T UiDurdur}" Command="{Binding Speed.CancelCommand}" Margin="0"
                                        Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiHizTestiniDurdur}" />
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:T UiIndirme}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Speed.DownloadText}" Style="{StaticResource Reading}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="1" Width="1" Background="{DynamicResource Divider}" Margin="16,4" />
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="{local:T UiYukleme}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Speed.UploadText}" Style="{StaticResource Reading}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Border Grid.Column="3" Width="1" Background="{DynamicResource Divider}" Margin="16,4" />
                            <StackPanel Grid.Column="4">
                                <TextBlock Text="{local:T UiPing}" Style="{StaticResource Caption}" />
                                <TextBlock Text="{Binding Speed.LatencyText}" Style="{StaticResource Reading}" Margin="0,2,0,0" />
                                <TextBlock Style="{StaticResource Caption}">
                                    <Run Text="{local:T UiTitresim}" />
                                    <Run Text="{Binding Speed.JitterText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,16,0,0" Visibility="{Binding Speed.IsRunning, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Speed.Percent}" Height="4"
                                         AutomationProperties.Name="{local:T UiHizTestiSuruyor}" />
                            <TextBlock Text="{Binding Speed.ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Speed.Status}" Style="{StaticResource BodyMuted}" Margin="0,12,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0" Visibility="{Binding Speed.HasResult, Converter={StaticResource BoolToVis}}">
                            <Button Content="{local:T UiSonucuPaylas}" Command="{Binding Speed.ShareCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiHizTestiSonucunuPaylas}" />
                            <!-- After the picture is copied: say so -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                        Visibility="{Binding Speed.HasShareStatus, Converter={StaticResource BoolToVis}}">
                                <Path Width="14" Height="14" Stretch="Uniform" Data="M3,8.5 L6.5,12 L13,4.5" Stroke="{DynamicResource StatusOk}"
                                      StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Speed.ShareStatus}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </StackPanel>
                        <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,0"
                                   Text="{local:T UiOlcumCloudflareSunuculariylaYapili}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ CONNECTION ============ -->
            <StackPanel Visibility="{Binding IsConnection, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource VerdictBand}" BorderThickness="1" CornerRadius="12" Padding="20,18" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource VerdictBar}" Width="10" Height="10" CornerRadius="5" VerticalAlignment="Top" Margin="0,8,12,0" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{Binding VerdictTitle}" Style="{StaticResource SectionTitle}" FontSize="19" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding VerdictDetail}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <ProgressBar Minimum="0" Maximum="100" Value="{Binding DiagnosisPercent}" AutomationProperties.Name="{local:T UiKontrolIlerlemesi}" />
                                <TextBlock Text="{Binding DiagnosisProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                            </StackPanel>
                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="{local:T UiBeniDuzelt}" Command="{Binding RepairPicker.OpenCommand}"
                                        Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiBeniDuzelt}" />
                                <Button Content="{local:T UiYenidenKontrolEt}" Command="{Binding RunDiagnosticsCommand}"
                                        Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiYenidenKontrolEt}" />
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- The diagnosis, as a rail: the layers really are a sequence -->
                <Border Style="{StaticResource Panel}" Padding="16,20,20,0" Visibility="{Binding HasRows, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="48" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Rectangle Width="2" Fill="{DynamicResource Divider}" HorizontalAlignment="Center" Margin="0,30,0,0" />
                                    <Border Style="{StaticResource StatusDot}" Width="30" Height="30" CornerRadius="15"
                                            VerticalAlignment="Top" HorizontalAlignment="Center"
                                            Background="{DynamicResource Card}" BorderThickness="2"
                                            AutomationProperties.Name="{Binding StatusLabel}">
                                        <Viewbox Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="16" Height="16">
                                                <Path Style="{StaticResource StatusPath}" Data="{Binding Icon}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="4,4,0,24">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Ellipse Style="{StaticResource KindDot}" Width="7" Height="7" Margin="0,0,6,0" />
                                                <TextBlock Text="{Binding StatusLabel}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="0,4,0,0" LineHeight="21" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVis}}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <!-- ============ SPEED-UP AND WINDOWS SETTINGS ============
                 Order: the two quick wins first (startup programs, disk), then the long Windows settings list. -->
            <StackPanel Visibility="{Binding IsTweaks, Converter={StaticResource BoolToVis}}">

                <!-- Startup programs -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiAcilistaBaslayanProgramlar}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiIsaretiniKaldirdiginizProgramSilin}" />

                        <Border Style="{StaticResource Callout}" Background="{DynamicResource BadSoft}" Margin="0,12,0,0"
                                Visibility="{Binding Startup.HasLoadError, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Startup.LoadError}" TextWrapping="Wrap" />
                        </Border>
                        <TextBlock Text="{local:T UiWindowsAcilisindaBaslayanBirProgra}" Style="{StaticResource BodyMuted}" Margin="0,12,0,0"
                                   Visibility="{Binding Startup.IsEmpty, Converter={StaticResource BoolToVis}}" />

                        <Expander Header="{Binding Startup.EnabledHeader}" Style="{StaticResource FoldSection}" Margin="0,14,0,0">
                            <ItemsControl ItemsSource="{Binding Startup.EnabledItems}" ItemTemplate="{StaticResource StartupRow}" />
                        </Expander>
                        <Expander Header="{Binding Startup.DisabledHeader}" Style="{StaticResource FoldSection}">
                            <ItemsControl ItemsSource="{Binding Startup.DisabledItems}" ItemTemplate="{StaticResource StartupRow}" />
                        </Expander>

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="{local:T UiDegisiklikleriUygula}" Command="{Binding Startup.ApplyCommand}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiAcilisDegisiklikleriniUygula}" />
                            <Button Content="{local:T UiListeyiYenile}" Command="{Binding Startup.RefreshCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiListeyiYenile}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Disk cleanup -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiDiskTemizligi}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiSectiginizGereksizDosyalarSilinirB}" />

                        <ItemsControl ItemsSource="{Binding Cleanup.Items}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding Title}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}" FontFamily="{StaticResource NumberFont}" FontSize="15"
                                                   FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Border Style="{StaticResource Hairline}" Margin="0,14,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel>
                                <Button Content="{local:T UiSecilenleriTemizle}" Command="{Binding Cleanup.CleanCommand}"
                                        Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiSecilenleriTemizle}" />
                                <Button Content="{local:T UiBoyutlariYenidenHesapla}" Command="{Binding Cleanup.ScanCommand}"
                                        Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiBoyutlariYenidenHesapla}" />
                            </WrapPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0">
                                <TextBlock Text="{local:T UiSecilenlerinToplami}" Style="{StaticResource Caption}" HorizontalAlignment="Right" />
                                <TextBlock Text="{Binding Cleanup.SelectedTotalText}" FontFamily="{StaticResource NumberFont}" FontSize="18"
                                           FontWeight="SemiBold" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ============ WINDOWS SETTINGS (the list comes from Win11Debloat, MIT) ============ -->
                <Grid Margin="0,36,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{local:T UiWindowsAyarlari}" Style="{StaticResource SectionTitle}" FontSize="20" AutomationProperties.HeadingLevel="Level2" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiGizlilikOnerilerYapayZekaGorevCubu}" />
                    </StackPanel>
                    <Button Grid.Column="1" Content="{local:T UiKaynakWin11debloat}" Command="{Binding OpenWin11DebloatCommand}"
                            Style="{StaticResource GhostButton}" VerticalAlignment="Top" Margin="12,0,-10,0"
                            ToolTip="{local:T UiAyarListesininAlindigiAcikKaynakPr}" AutomationProperties.Name="{local:T UiWin11debloatGithubSayfasi}" />
                </Grid>

                <!-- In the app's accent colour until the settings have been saved once -->
                <Border Style="{StaticResource Callout}" Visibility="{Binding Tweaks.NeedsBackup, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:T UiMevcutWindowsAyarlarinizHenuzKayde}" FontWeight="SemiBold"
                                       TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0" Foreground="{DynamicResource Foreground}" Opacity="0.85"
                                       Text="{local:T UiBirSorunCikarsaOncekiHalineDonebil}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{local:T UiMevcutAyarlariKaydet}" Command="{Binding Tweaks.SaveBackupCommand}" Style="{StaticResource PrimaryButton}"
                                VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="{local:T UiMevcutAyarlariKaydet}" />
                    </Grid>
                </Border>

                <!-- Ready-made picks and saved settings -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiHazirAyarlar}" Style="{StaticResource SectionTitle}" FontSize="15.5" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0"
                                   Text="{local:T UiSecmekHicbirSeyiDegistirmezUygulam}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button Content="{local:T UiOnerilenAyarlariSec}" Command="{Binding Tweaks.SelectRecommendedCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiOnerilenAyarlariSec}"
                                    ToolTip="{local:T UiCoguKullaniciIcinGuvenliVeYararli}" />
                            <Button Content="{local:T UiWindowsVarsayilaninaDondur}" Command="{Binding Tweaks.ResetToDefaultsCommand}"
                                    Style="{StaticResource SecondaryButton}" ToolTip="{local:T UiFoxfixInDegistirdigiAyarlarWindows}"
                                    AutomationProperties.Name="{local:T UiWindowsVarsayilaninaDondur}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Hairline}" Margin="0,18,0,14" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{local:T UiKayitliAyarlarim}" Style="{StaticResource SectionTitle}" FontSize="15.5" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Content="{local:T UiMevcutAyarlariKaydet}" Command="{Binding Tweaks.SaveBackupCommand}"
                                    Style="{StaticResource RowButton}" AutomationProperties.Name="{local:T UiMevcutAyarlariKaydet}" />
                        </Grid>
                        <TextBlock Text="{local:T UiHenuzKayitYokKaydettiginizAyarlarB}"
                                   Style="{StaticResource Caption}" Margin="0,8,0,0"
                                   Visibility="{Binding Tweaks.HasBackups, Converter={StaticResource InverseBoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Tweaks.Backups}" Margin="0,6,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding DateText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{local:T UiGeriYukle}" Style="{StaticResource RowButton}"
                                                    Command="{Binding DataContext.Tweaks.RestoreBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{local:T UiBuKayittakiAyarlariGeriYukle}" />
                                            <Button Content="{local:T UiSil}" Style="{StaticResource RowButton}"
                                                    Command="{Binding DataContext.Tweaks.DeleteBackupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{local:T UiBuKaydiSil}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Tweaks.BackupStatus}" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding Tweaks.HasBackupStatus, Converter={StaticResource BoolToVis}}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource StatusOk}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Tweaks.BackupStatusIsError}" Value="True">
                                            <Setter Property="Foreground" Value="{DynamicResource StatusBad}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Search, then the one action of this list -->
                <Border Margin="0,24,0,0" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                        CornerRadius="10" Padding="14,0,6,0" Height="42">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Stroke="{DynamicResource Muted}" StrokeThickness="1.6"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M6.5,1.5 A5,5 0 1 0 6.5,11.5 A5,5 0 1 0 6.5,1.5 M10.2,10.2 L14.5,14.5" />
                        <Grid Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{local:T UiAyarAraOrneginReklamCopilotAnimasy}" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource BodyMuted}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Tweaks.SearchText}" Value="">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBox Text="{Binding Tweaks.SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0"
                                     Padding="0" AutomationProperties.Name="{local:T UiAyarAra}" VerticalAlignment="Center">
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Grid>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" Height="30" ToolTip="{local:T UiAramayiTemizle}"
                                AutomationProperties.Name="{local:T UiAramayiTemizle}" Command="{Binding Tweaks.ClearSearchCommand}"
                                Visibility="{Binding Tweaks.HasSearch, Converter={StaticResource BoolToVis}}">
                            <Path Width="10" Height="10" Stretch="Uniform" Data="M2,2 L12,12 M12,2 L2,12" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                        </Button>
                    </Grid>
                </Border>
                <Grid Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{local:T UiSecilenleriUygula}" Command="{Binding Tweaks.ApplyCommand}"
                            Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiSecilenAyarlariUygula}" />
                    <TextBlock Grid.Column="1" Text="{Binding Tweaks.SelectedText}" Style="{StaticResource BodyMuted}" VerticalAlignment="Center"
                               Margin="4,0,0,0" AutomationProperties.LiveSetting="Polite" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Content="{local:T UiTumunuAc}" Command="{Binding Tweaks.ExpandAllCommand}" Margin="0"
                                Style="{StaticResource GhostButton}" AutomationProperties.Name="{local:T UiTumListeleriAc}" />
                        <Button Content="{local:T UiTumunuKapat}" Command="{Binding Tweaks.CollapseAllCommand}" Margin="0,0,-10,0"
                                Style="{StaticResource GhostButton}" AutomationProperties.Name="{local:T UiTumListeleriKapat}" />
                    </StackPanel>
                </Grid>
                <TextBlock Style="{StaticResource Caption}" Margin="0,10,0,0"
                           Text="{local:T UiYuzdelerNeKadarFarkYaratacaginaDai}" />
                <TextBlock Text="{local:T UiAramanizaUyanAyarYokBaskaBir}" Style="{StaticResource BodyMuted}" Margin="0,16,0,0"
                           Visibility="{Binding Tweaks.HasResults, Converter={StaticResource InverseBoolToVis}}" />

                <!-- The lists: one surface, a hairline between lists -->
                <Border Style="{StaticResource Panel}" Padding="8" Margin="0,12,0,0" Visibility="{Binding Tweaks.HasResults, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Tweaks.Categories}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Visibility="{Binding HasVisible, Converter={StaticResource BoolToVis}}">
                                    <Button Command="{Binding ToggleExpandedCommand}" Style="{StaticResource FoldHeader}" AutomationProperties.Name="{Binding Title}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="12" Height="12" VerticalAlignment="Center">
                                                <Path Data="M5,3 L10,8 L5,13" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource InverseBoolToVis}}" />
                                                <Path Data="M3,5 L8,10 L13,5" Stroke="{DynamicResource Muted}" StrokeThickness="1.8" StrokeStartLineCap="Round"
                                                      StrokeEndLineCap="Round" StrokeLineJoin="Round" Stretch="Uniform"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                            <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Margin="12,0,0,0"
                                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="2" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Button>

                                    <StackPanel Margin="34,0,12,14" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                        <Button Content="{local:T UiBuListedekiOnerilenleriSec}" Command="{Binding SelectRecommendedCommand}" Style="{StaticResource GhostButton}"
                                                HorizontalAlignment="Left" Margin="-10,0,0,0" AutomationProperties.Name="{local:T UiBuListedekiOnerilenleriSec}"
                                                Visibility="{Binding HasToggles, Converter={StaticResource BoolToVis}}" />

                                        <ItemsControl ItemsSource="{Binding Toggles}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,8,0,4" Visibility="{Binding IsMatch, Converter={StaticResource BoolToVis}}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" Margin="0"
                                                                  AutomationProperties.Name="{Binding Title}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                           Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                                <WrapPanel Margin="0,6,0,0">
                                                                    <!-- Area in plain muted words; the impact as a small badge: neutral text on a tint, with a dot in the level's colour -->
                                                                    <TextBlock Text="{Binding AreaName}" Style="{StaticResource Caption}" Margin="0,0,10,0" VerticalAlignment="Center"
                                                                               Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}" />
                                                                    <Border CornerRadius="10" Padding="8,2" Margin="0,0,8,0" VerticalAlignment="Center"
                                                                            Visibility="{Binding HasInfo, Converter={StaticResource BoolToVis}}">
                                                                        <Border.Style>
                                                                            <Style TargetType="Border">
                                                                                <Setter Property="Background" Value="{DynamicResource OkSoft}" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding ImpactLevel}" Value="Medium">
                                                                                        <Setter Property="Background" Value="{DynamicResource WarnSoft}" />
                                                                                    </DataTrigger>
                                                                                    <DataTrigger Binding="{Binding ImpactLevel}" Value="High">
                                                                                        <Setter Property="Background" Value="{DynamicResource BadSoft}" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Border.Style>
                                                                        <StackPanel Orientation="Horizontal">
                                                                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                                                                <Ellipse.Style>
                                                                                    <Style TargetType="Ellipse">
                                                                                        <Setter Property="Fill" Value="{DynamicResource StatusOk}" />
                                                                                        <Style.Triggers>
                                                                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="Medium">
                                                                                                <Setter Property="Fill" Value="{DynamicResource StatusWarn}" />
                                                                                            </DataTrigger>
                                                                                            <DataTrigger Binding="{Binding ImpactLevel}" Value="High">
                                                                                                <Setter Property="Fill" Value="{DynamicResource StatusBad}" />
                                                                                            </DataTrigger>
                                                                                        </Style.Triggers>
                                                                                    </Style>
                                                                                </Ellipse.Style>
                                                                            </Ellipse>
                                                                            <TextBlock Text="{Binding ImpactBadgeText}" FontSize="12" Foreground="{DynamicResource Foreground}" />
                                                                        </StackPanel>
                                                                    </Border>
                                                                    <Border BorderBrush="{DynamicResource AccentText}" BorderThickness="1" CornerRadius="10" Padding="7,1" Margin="0,0,8,0"
                                                                            VerticalAlignment="Center" Visibility="{Binding IsRecommended, Converter={StaticResource BoolToVis}}">
                                                                        <TextBlock Text="{local:T UiOnerilen}" FontSize="12" Foreground="{DynamicResource AccentText}" />
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding IsApplied, Converter={StaticResource BoolToVis}}">
                                                                        <Path Width="11" Height="11" Stretch="Uniform" Data="M3,8.5 L6.5,12 L13,4.5" Stroke="{DynamicResource StatusOk}"
                                                                              StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                                              VerticalAlignment="Center" Margin="0,0,5,0" />
                                                                        <TextBlock Text="{local:T UiUygulandi}" FontSize="12" Foreground="{DynamicResource Foreground}" />
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                            </StackPanel>
                                                        </CheckBox>
                                                        <Button Grid.Column="1" Content="{local:T UiGeriAc}" VerticalAlignment="Top" Style="{StaticResource RowButton}"
                                                                ToolTip="{local:T UiBuAyariWindowsUnKendiDegerine}"
                                                                Command="{Binding DataContext.Tweaks.RevertCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" AutomationProperties.Name="{local:T UiBuAyariGeriAc}"
                                                                Visibility="{Binding CanRevert, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <ItemsControl ItemsSource="{Binding Groups}" Focusable="False">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,16,0,0" Visibility="{Binding IsMatch, Converter={StaticResource BoolToVis}}">
                                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Caption}" Margin="0,2,0,0"
                                                                   Visibility="{Binding HasDescription, Converter={StaticResource BoolToVis}}" />
                                                        <ItemsControl ItemsSource="{Binding Choices}" Margin="0,4,0,0" Focusable="False">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <RadioButton IsChecked="{Binding IsSelected}" Margin="0,7,0,0" AutomationProperties.Name="{Binding Label}">
                                                                        <WrapPanel>
                                                                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                                            <TextBlock Text="{local:T UiSuAn}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"
                                                                                       Margin="8,1,0,0" VerticalAlignment="Center"
                                                                                       Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}" />
                                                                        </WrapPanel>
                                                                    </RadioButton>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                    <Border Height="1" Background="{DynamicResource Divider}" Margin="10,0" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ============ DNS AND DPI ============ -->
            <StackPanel Visibility="{Binding IsDnsDpi, Converter={StaticResource BoolToVis}}">

                <!-- Windows DNS comes first: on many computers FoxDPI does not work without it, so it gets the accent frame and a "recommended" tag -->
                <Border Style="{StaticResource Panel}" BorderBrush="{DynamicResource Accent}" BorderThickness="2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="{local:T UiWindowsDnsAyari}" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Border Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentText}" BorderThickness="1" CornerRadius="10"
                                        Padding="9,2" Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{local:T DnsRecommendedTag}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                                </Border>
                            </WrapPanel>
                            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                       Text="{local:T UiFoxdpiAcikkenHalaBaglanamiyorsaniz}" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" Text="{local:T DnsRecommendedWhy}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{local:T UiDnsI1111}" Command="{Binding Dpi.SetCloudflareDnsCommand}"
                                Style="{StaticResource PrimaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                AutomationProperties.Name="{local:T UiDnsI11112}" />
                    </Grid>
                </Border>

                <!-- FoxDPI: what it is, its state now, and what may need admin rights -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{DynamicResource FoxDpiLogoImage}" Height="40" Margin="0,0,14,0" VerticalAlignment="Top"
                                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="{local:T UiFoxdpiLogosu}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="FoxDPI" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                           Text="{local:T UiErisimEngeliOlanSitelereBaglanmani}" />
                            </StackPanel>
                        </Grid>
                        <Border Background="{DynamicResource Background}" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                            <TextBlock Text="{Binding Dpi.StatusText}" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </Border>

                        <Border Style="{StaticResource Callout}" Margin="0,12,0,0" Visibility="{Binding Dpi.NeedsElevation, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{local:T UiDenemekVeKurmakIcinYoneticiIzni}" />
                                <Button Grid.Column="1" Content="{local:T UiYoneticiOlarakYenidenAc}" Command="{Binding Dpi.ElevateCommand}"
                                        Style="{StaticResource PrimaryButton}" Margin="16,0,0,0" VerticalAlignment="Center"
                                        AutomationProperties.Name="{local:T UiYoneticiOlarakYenidenAc}" />
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource CalloutWarn}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Path Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" Margin="0,2,12,0" Stroke="{DynamicResource StatusWarn}"
                                      StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M8,1.8 L14.6,13.6 L1.4,13.6 Z M8,6 L8,9.4 M8,11.6 L8,11.7" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{local:T UiOyunlarVeHileOnlemeSistemleri}" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Caption}" Margin="0,3,0,0" Foreground="{DynamicResource Foreground}" Opacity="0.85"
                                               Text="{local:T UiEasyanticheatVanguardFaceitGibiSis}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Find the setting that works here, then pick it -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiEnUygunAyariBul}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiHerAyarAsagidakiSitelerdeDenenirBi}" />
                        <TextBlock Text="{local:T UiDenenecekSiteler}" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,6" />
                        <TextBox Text="{Binding Dpi.Hosts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:T UiDenenecekSiteler}"
                                 IsEnabled="{Binding Dpi.CanAct}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0" Text="{local:T UiSiteleriVirgulleAyirin}" />

                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="{local:T UiEnUygunAyariBul}" Command="{Binding Dpi.RunTrialCommand}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiEnUygunAyariBul}" />
                            <Button Content="{local:T UiDurdur}" Command="{Binding Dpi.RunTrialCancelCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiDenemeyiDurdur}" />
                        </WrapPanel>
                        <StackPanel Margin="0,14,0,0" Visibility="{Binding Dpi.IsTesting, Converter={StaticResource BoolToVis}}">
                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding Dpi.TrialPercent}" AutomationProperties.Name="{local:T UiDenemeIlerlemesi}" />
                            <TextBlock Text="{Binding Dpi.TrialProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>

                        <TextBlock Text="{Binding Dpi.ResultText}" Margin="0,14,0,0" TextWrapping="Wrap" LineHeight="21"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding Dpi.HasResult, Converter={StaticResource BoolToVis}}" />

                        <!-- The settings, one per line: pick the one to use -->
                        <Border Style="{StaticResource Hairline}" Margin="0,18,0,8" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                                   Text="{local:T UiFoxdpiHizmetOlarakKuruluOlduguIcin}"
                                   Visibility="{Binding Dpi.IsServiceInstalled, Converter={StaticResource BoolToVis}}" />
                        <ItemsControl ItemsSource="{Binding Dpi.Rows}" IsEnabled="{Binding Dpi.CanChangeSetting}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton GroupName="gdpi" IsChecked="{Binding IsSelected}" Margin="0,4" AutomationProperties.Name="{Binding Title}">
                                            <WrapPanel>
                                                <TextBlock Text="{Binding Title}" TextWrapping="Wrap" />
                                                <TextBlock Text="{local:T UiOnerilen2}" Foreground="{DynamicResource AccentText}" FontWeight="SemiBold" FontSize="12"
                                                           Margin="8,1,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsBest, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                        </RadioButton>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                            <Ellipse Style="{StaticResource KindDot}" />
                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- How FoxDPI runs -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiCalistirma}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiElleBaslatabilirWindowsAcilincaBas}" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{Binding Dpi.FoxDpiButtonText}" Command="{Binding Dpi.ToggleFoxDpiCommand}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiFoxdpiYiBaslat}" />
                            <Button Content="{local:T UiDurdur}" Command="{Binding Dpi.StopCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiFoxdpiDurdur}" />
                            <Button Content="{local:T UiHizmetOlarakKur}" Command="{Binding Dpi.InstallServiceCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiHizmetOlarakKur}" />
                            <Button Content="{local:T UiHizmetiKaldir}" Command="{Binding Dpi.RemoveServiceCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiHizmetiKaldir}"
                                    Visibility="{Binding Dpi.IsServiceInstalled, Converter={StaticResource BoolToVis}}" />
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding Dpi.IsAutoStart, Mode=OneWay}" Command="{Binding Dpi.ToggleAutoStartCommand}"
                                  Margin="0,16,0,0" HorizontalAlignment="Left" AutomationProperties.Name="{local:T UiFoxdpiYiWindowsAcilincaBaslat}">
                            <StackPanel>
                                <TextBlock Text="{local:T UiFoxdpiYiWindowsAcilincaBaslat}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{local:T UiHizmetKurmadanZamanlanmisGorevOlar}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <!-- Reset: what it removes, and that it can be undone -->
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:T UiDpiSifirlama}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                           Text="{local:T UiAgAyarlariniTemizleyipWindowsVarsa}" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{local:T UiDpiSifirlama}" Command="{Binding Dpi.ResetCommand}"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    AutomationProperties.Name="{local:T UiDpiSifirlama}" />
                        </Grid>
                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="•" Style="{StaticResource Caption}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource Caption}"
                                       Text="{local:T UiEskiGoodbyedpiWindivertVeZapretKal}" />
                            <TextBlock Grid.Row="1" Text="•" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Text="{local:T UiYapilacaklarOnceListelenirOnaylama}" />
                            <TextBlock Grid.Row="2" Text="•" Style="{StaticResource Caption}" Margin="0,3,0,0" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource Caption}" Margin="0,3,0,0"
                                       Text="{local:T UiDnsAyarlariVeKaldirilanHizmetlerSo}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ GAME OVERLAY ============ -->
            <StackPanel Visibility="{Binding IsOverlay, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Callout}" Margin="0,16,0,0">
                    <TextBlock Text="{local:T OverlayIntro}" TextWrapping="Wrap" LineHeight="21" />
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding Overlay.Enabled}" HorizontalAlignment="Left" AutomationProperties.Name="{local:T OverlayEnable}">
                            <StackPanel>
                                <TextBlock Text="{local:T OverlayEnable}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{local:T OverlayEnableText}" />
                            </StackPanel>
                        </CheckBox>

                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{Binding Overlay.ToggleText}" Command="{Binding Overlay.ToggleVisibleCommand}" Style="{StaticResource PrimaryButton}"
                                    AutomationProperties.Name="{Binding Overlay.ToggleText}" />
                        </WrapPanel>
                        <TextBlock Text="{Binding Overlay.Message}" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="{DynamicResource StatusWarn}"
                                   Visibility="{Binding Overlay.HasMessage, Converter={StaticResource BoolToVis}}" AutomationProperties.LiveSetting="Polite" />

                        <Border Style="{StaticResource Hairline}" />
                        <TextBlock Text="{local:T OverlayHotkey}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Text="{local:T OverlayHotkeyText}" Style="{StaticResource Caption}" Margin="0,2,0,8" TextWrapping="Wrap" />
                        <TextBox x:Name="HotkeyBox" Text="{Binding Overlay.Hotkey, Mode=OneWay}" IsReadOnly="True" Width="200" HorizontalAlignment="Left"
                                 HorizontalContentAlignment="Center" PreviewKeyDown="OnHotkeyKeyDown" AutomationProperties.Name="{local:T OverlayHotkeyBoxName}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T OverlayWhat}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel Margin="0,10,0,0">
                            <CheckBox Content="{local:T OverlayFps}" IsChecked="{Binding Overlay.ShowFps}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayFps}" />
                            <CheckBox Content="{local:T OverlayFrameTime}" IsChecked="{Binding Overlay.ShowFrameTime}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayFrameTime}" />
                            <CheckBox Content="{local:T OverlayGpu}" IsChecked="{Binding Overlay.ShowGpu}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayGpu}" />
                            <CheckBox Content="{local:T OverlayCpu}" IsChecked="{Binding Overlay.ShowCpu}" Margin="0,0,0,6" AutomationProperties.Name="{local:T OverlayCpu}" />
                        </WrapPanel>
                        <TextBlock Text="{local:T OverlayNothing}" Style="{StaticResource Caption}" Foreground="{DynamicResource StatusWarn}"
                                   Visibility="{Binding Overlay.AnythingShown, Converter={StaticResource InverseBoolToVis}}" />

                        <Border Style="{StaticResource Hairline}" />
                        <TextBlock Text="{local:T OverlayBackground}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <WrapPanel>
                            <RadioButton GroupName="ovbg" Content="{local:T OverlayBgTranslucent}" IsChecked="{Binding Overlay.IsTranslucent}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayBgTranslucent}" />
                            <RadioButton GroupName="ovbg" Content="{local:T OverlayBgThemed}" IsChecked="{Binding Overlay.IsThemed}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayBgThemed}" />
                            <RadioButton GroupName="ovbg" Content="{local:T OverlayBgNone}" IsChecked="{Binding Overlay.IsNoBackground}" Margin="0,0,0,6" AutomationProperties.Name="{local:T OverlayBgNone}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Hairline}" />
                        <TextBlock Text="{local:T OverlayCorner}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <WrapPanel>
                            <RadioButton GroupName="ovcorner" Content="{local:T OverlayTopLeft}" IsChecked="{Binding Overlay.IsTopLeft}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayTopLeft}" />
                            <RadioButton GroupName="ovcorner" Content="{local:T OverlayTopRight}" IsChecked="{Binding Overlay.IsTopRight}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayTopRight}" />
                            <RadioButton GroupName="ovcorner" Content="{local:T OverlayBottomLeft}" IsChecked="{Binding Overlay.IsBottomLeft}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayBottomLeft}" />
                            <RadioButton GroupName="ovcorner" Content="{local:T OverlayBottomRight}" IsChecked="{Binding Overlay.IsBottomRight}" Margin="0,0,24,6" AutomationProperties.Name="{local:T OverlayBottomRight}" />
                            <RadioButton GroupName="ovcorner" Content="{local:T OverlayFree}" IsChecked="{Binding Overlay.IsFree}" Margin="0,0,0,6" AutomationProperties.Name="{local:T OverlayFree}" />
                        </WrapPanel>
                        <!-- Free place: the strip is shown with sample numbers and dragged where it should be -->
                        <StackPanel Visibility="{Binding Overlay.IsFree, Converter={StaticResource BoolToVis}}" Margin="0,4,0,0">
                            <Button Content="{Binding Overlay.PlaceText}" Command="{Binding Overlay.PlaceCommand}" HorizontalAlignment="Left"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{Binding Overlay.PlaceText}" />
                            <TextBlock Text="{local:T OverlayFreeHint}" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>

                        <Border Style="{StaticResource Hairline}" />
                        <TextBlock Text="{local:T OverlaySize}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,2" />
                        <TextBlock Text="{Binding Overlay.ScaleText}" Style="{StaticResource Caption}" />
                        <Slider Style="{StaticResource BrightnessSlider}" Minimum="50" Maximum="250" SmallChange="5" LargeChange="25" TickFrequency="5"
                                IsSnapToTickEnabled="True" Margin="0,6,0,0" Value="{Binding Overlay.ScalePercent, Mode=TwoWay}"
                                AutomationProperties.Name="{local:T OverlaySize}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CalloutWarn}" Margin="0,12,0,0">
                    <TextBlock Text="{local:T OverlayLimits}" TextWrapping="Wrap" LineHeight="21" />
                </Border>
            </StackPanel>

            <!-- ============ ACCESS TEST ============ -->
            <StackPanel Visibility="{Binding IsAccess, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiDenenecekSiteler}" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,6" />
                        <TextBox Text="{Binding Access.Hosts, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:T UiDenenecekSiteler}" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,6,0,0"
                                   Text="{local:T UiSiteleriVirgulleAyirinKarsilastirm}" />
                        <WrapPanel Margin="0,16,0,0">
                            <Button Content="{local:T UiTestiBaslat}" Command="{Binding Access.RunCommand}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiTestiBaslat}" />
                            <Button Content="{local:T UiDurdur}" Command="{Binding Access.RunCancelCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiTestiDurdur}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}" Visibility="{Binding Access.HasSummary, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{Binding Access.SummaryText}" Style="{StaticResource SectionTitle}" FontSize="16"
                                   AutomationProperties.LiveSetting="Polite" />
                        <ItemsControl ItemsSource="{Binding Access.Rows}" Margin="0,10,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Host}" />
                                                <TextBlock Text="{local:T UiKarsilastirmaSitesi}" Style="{StaticResource Caption}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                           Visibility="{Binding IsControl, Converter={StaticResource BoolToVis}}" />
                                            </WrapPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <Ellipse Style="{StaticResource KindDot}" />
                                                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Foreground}" />
                                                <TextBlock Text="{Binding ElapsedText}" Style="{StaticResource Caption}" />
                                            </StackPanel>
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Divider}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Access.DpiNote}" Style="{StaticResource Caption}" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ SOUND AND CAMERA (wizard: looks, listens or shows only; changes nothing, records nothing) ============ -->
            <StackPanel Visibility="{Binding IsDevices, Converter={StaticResource BoolToVis}}">
                <Border Style="{StaticResource Callout}" Margin="0,16,0,0">
                    <TextBlock Text="{local:T DevIntro}" TextWrapping="Wrap" LineHeight="21" />
                </Border>

                <Border Style="{StaticResource Panel}" DataContext="{Binding Devices.Current}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" FontSize="20" AutomationProperties.HeadingLevel="Level2" />
                            <TextBlock Grid.Column="1" Text="{Binding DataContext.Devices.StepText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       Style="{StaticResource Caption}" VerticalAlignment="Center" />
                        </Grid>

                        <!-- The finding: a dot, and the words that carry the meaning -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="10" Height="10" Margin="0,6,10,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource StatusNeutral}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VerdictKind}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource StatusOk}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding VerdictKind}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource StatusWarn}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding VerdictKind}" Value="Bad"><Setter Property="Fill" Value="{DynamicResource StatusBad}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding VerdictText}" TextWrapping="Wrap" LineHeight="21" FontWeight="SemiBold"
                                       AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsChecking, Converter={StaticResource BoolToVis}}">
                            <ProgressBar IsIndeterminate="True" AutomationProperties.Name="{local:T DevChecking}" />
                            <TextBlock Text="{local:T DevChecking}" Style="{StaticResource Caption}" Margin="0,6,0,0" />
                        </StackPanel>

                        <Border Style="{StaticResource Hairline}" />

                        <Expander Header="{Binding DevicesHeader}" Style="{StaticResource FoldSection}" Margin="0,2,0,0">
                            <StackPanel>
                                <TextBlock Text="{local:T DevNoDevices}" Style="{StaticResource Caption}" Margin="0,6,0,0"
                                           Visibility="{Binding HasNoDevices, Converter={StaticResource BoolToVis}}" />
                                <ItemsControl ItemsSource="{Binding Devices}" Margin="0,4,0,0" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                                                    <Ellipse Style="{StaticResource KindDot}" />
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Caption}" Foreground="{DynamicResource Foreground}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Expander>

                        <StackPanel Visibility="{Binding HasPrivacy, Converter={StaticResource BoolToVis}}">
                            <Border Style="{StaticResource Hairline}" />
                            <TextBlock Text="{local:T DevPrivacyHeader}" FontWeight="SemiBold" FontSize="13" />
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource StatusNeutral}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding PrivacyKind}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource StatusOk}" /></DataTrigger>
                                                <DataTrigger Binding="{Binding PrivacyKind}" Value="Bad"><Setter Property="Fill" Value="{DynamicResource StatusBad}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Grid.Column="1" Text="{Binding PrivacyText}" TextWrapping="Wrap" LineHeight="20" />
                            </Grid>
                        </StackPanel>

                        <StackPanel Visibility="{Binding HasSettingsLink, Converter={StaticResource BoolToVis}}" Margin="0,14,0,0">
                            <Button Content="{Binding SettingsLabel}" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}"
                                    Command="{Binding DataContext.Devices.OpenSettingsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding SettingsUri}" AutomationProperties.Name="{Binding SettingsLabel}" />
                        </StackPanel>
                        <TextBlock Text="{Binding DataContext.Devices.ActionError, RelativeSource={RelativeSource AncestorType=Window}}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource StatusBad}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                </Border>

                <!-- The test sound: started and stopped by the person. Only the speakers have a test; microphone and camera are checked, never listened to or filmed. -->
                <Border Style="{StaticResource Panel}" DataContext="{Binding Devices.Current}" Visibility="{Binding IsSpeaker, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="{local:T DevToneHint}" Style="{StaticResource BodyMuted}" />

                        <WrapPanel Margin="0,14,0,0">
                            <Button Style="{StaticResource PrimaryButton}" IsEnabled="{Binding CanStartTest}" Content="{local:T DevPlayTone}"
                                    Command="{Binding DataContext.Devices.StartTestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.Name="{local:T DevPlayTone}" />
                            <Button Content="{local:T DevStop}" Style="{StaticResource SecondaryButton}" IsEnabled="{Binding IsTesting}"
                                    Command="{Binding DataContext.Devices.StopTestCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    AutomationProperties.Name="{local:T DevStop}" />
                        </WrapPanel>

                        <Grid Margin="0,12,0,0" Visibility="{Binding HasTestStatus, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Margin="0,6,8,0" VerticalAlignment="Top">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource StatusNeutral}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TestKind}" Value="Ok"><Setter Property="Fill" Value="{DynamicResource StatusOk}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TestKind}" Value="Warn"><Setter Property="Fill" Value="{DynamicResource StatusWarn}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding TestKind}" Value="Bad"><Setter Property="Fill" Value="{DynamicResource StatusBad}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding TestStatus}" TextWrapping="Wrap" LineHeight="21" AutomationProperties.LiveSetting="Polite" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Steps -->
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <WrapPanel>
                        <Button Content="{local:T DevPrevious}" Command="{Binding Devices.PreviousCommand}" Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="{local:T DevPrevious}" />
                        <Button Content="{local:T DevNextStep}" Command="{Binding Devices.NextCommand}" Style="{StaticResource PrimaryButton}"
                                AutomationProperties.Name="{local:T DevNextStep}" />
                        <Button Content="{local:T DevFinish}" Command="{Binding GoHomeCommand}" Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="{local:T DevFinish}" />
                    </WrapPanel>
                    <Button Grid.Column="1" Content="{local:T DevCheckAgain}" Command="{Binding Devices.CheckAgainCommand}" Style="{StaticResource GhostButton}"
                            Margin="0,0,-10,0" AutomationProperties.Name="{local:T DevCheckAgain}" />
                </Grid>
            </StackPanel>

            <!-- ============ REPORT AND HISTORY ============ -->
            <StackPanel Visibility="{Binding IsReport, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiYapilanDegisiklikler}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{local:T UiFoxfixInYaptigiHerDegisiklikBurada}" Style="{StaticResource BodyMuted}" Margin="0,4,0,0" />
                        <Border Background="{DynamicResource Background}" CornerRadius="8" Padding="14,12" Margin="0,14,0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Fix.HasUndoItems}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{local:T UiFoxfixHenuzBirDegisiklikYapmadiBen}" Style="{StaticResource BodyMuted}" />
                        </Border>
                        <ItemsControl ItemsSource="{Binding Fix.UndoItems}" Margin="0,8,0,0" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <Grid Margin="0,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" VerticalAlignment="Center" LineHeight="21" />
                                            <Button Grid.Column="1" Content="{local:T UiGeriAl}" Style="{StaticResource RowButton}" Margin="16,0,0,0"
                                                    Command="{Binding DataContext.Fix.UndoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" AutomationProperties.Name="{local:T UiBuDegisikligiGeriAl}" />
                                        </Grid>
                                        <Border Height="1" Background="{DynamicResource Divider}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiDestekRaporu}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiYardimIsterkenPaylasabileceginizBi}" />
                        <WrapPanel Margin="0,14,0,0">
                            <Button Content="{local:T UiRaporuKopyala}" Command="{Binding CopyReportCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiRaporuKopyala}" />
                            <Button Content="{local:T UiRaporuKaydet}" Command="{Binding SaveReportCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiRaporuKaydet2}" />
                        </WrapPanel>
                        <CheckBox IsChecked="{Binding ShowPersonalData}" Margin="0,16,0,0" AutomationProperties.Name="{local:T UiKisiselBilgileriRaporaEkle}">
                            <StackPanel>
                                <TextBlock Text="{local:T UiKisiselBilgileriRaporaEkle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                           Text="{local:T UiKullaniciAdiBilgisayarAdiMacVe}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- ============ SETTINGS ============ -->
            <StackPanel Visibility="{Binding IsSettings, Converter={StaticResource BoolToVis}}">

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiLanguage}" Style="{StaticResource SectionTitle}" />
                        <WrapPanel Margin="0,12,0,0">
                            <RadioButton GroupName="language" Content="{local:T LangTurkish}" IsChecked="{Binding Settings.IsTurkish}"
                                         Margin="0,0,24,6" AutomationProperties.Name="Türkçe" />
                            <RadioButton GroupName="language" Content="{local:T LangEnglish}" IsChecked="{Binding Settings.IsEnglish}"
                                         Margin="0,0,0,6" AutomationProperties.Name="English" />
                        </WrapPanel>
                        <TextBlock Text="{local:T UiLanguageNote}" Style="{StaticResource Caption}" />

                        <Border Style="{StaticResource Hairline}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:T UiTourSection}" FontWeight="SemiBold" />
                                <TextBlock Text="{local:T UiTourSectionNote}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{local:T UiStartTour}" Command="{Binding Onboarding.StartTourFromSettingsCommand}"
                                    Style="{StaticResource SecondaryButton}" VerticalAlignment="Center" Margin="16,0,0,0"
                                    AutomationProperties.Name="{local:T UiStartTour}" />
                        </Grid>
                    </StackPanel>
                </Border>


                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{local:T UiGuncellemeler}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Updates.CurrentVersionText}" Style="{StaticResource BodyMuted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="{local:T UiGuncellemeleriDenetle}" Command="{Binding Updates.CheckNowCommand}" Margin="16,0,0,0"
                                    VerticalAlignment="Center" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiGuncellemeleriDenetle}" />
                        </Grid>
                        <TextBlock Text="{Binding Updates.StatusText}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite"
                                   Visibility="{Binding Updates.HasStatus, Converter={StaticResource BoolToVis}}" />
                        <WrapPanel Margin="0,12,0,0" Visibility="{Binding Updates.HasUpdate, Converter={StaticResource BoolToVis}}">
                            <Button Content="{local:T UiSimdiGuncelle}" Command="{Binding Updates.InstallCommand}"
                                    Style="{StaticResource PrimaryButton}" AutomationProperties.Name="{local:T UiSimdiGuncelle}"
                                    Visibility="{Binding Updates.CanInstall, Converter={StaticResource BoolToVis}}" />
                            <Button Content="{local:T UiSurumSayfasiniAc}" Command="{Binding Updates.OpenReleaseCommand}"
                                    Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiSurumSayfasiniAc}" />
                        </WrapPanel>
                        <Border Style="{StaticResource Hairline}" Margin="0,16,0,4" />
                        <CheckBox IsChecked="{Binding Settings.AutoCheckUpdates}" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{local:T UiGuncellemeleriHerAcilistaOtomatikD}">
                            <StackPanel>
                                <TextBlock Text="{local:T UiHerAcilistaGuncellemeleriDenetle}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{local:T UiFoxfixAcilincaGithubAEnSon}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T UiGorunum}" Style="{StaticResource SectionTitle}" />

                        <TextBlock Text="{local:T UiTema}" FontWeight="SemiBold" FontSize="13" Margin="0,14,0,8" />
                        <WrapPanel>
                            <RadioButton GroupName="theme" Content="{local:T UiWindowsAUy}" IsChecked="{Binding Settings.IsSystemTheme}"
                                         Margin="0,0,24,6" AutomationProperties.Name="{local:T UiTemaWindowsAUy}" />
                            <RadioButton GroupName="theme" Content="{local:T UiAydinlik}" IsChecked="{Binding Settings.IsLightTheme}"
                                         Margin="0,0,24,6" AutomationProperties.Name="{local:T UiTemaAydinlik}" />
                            <RadioButton GroupName="theme" Content="{local:T UiKaranlik}" IsChecked="{Binding Settings.IsDarkTheme}"
                                         Margin="0,0,0,6" AutomationProperties.Name="{local:T UiTemaKaranlik}" />
                        </WrapPanel>

                        <Border Style="{StaticResource Hairline}" />
                        <TextBlock Text="{local:T UiVurguRengi}" FontWeight="SemiBold" FontSize="13" />
                        <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,10"
                                   Text="{local:T UiDugmelerSeciliSayfaVeSecimlerBu}" />
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl ItemsSource="{Binding Settings.Swatches}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.Settings.PickAccentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding Hex}" ToolTip="{Binding Name}" AutomationProperties.Name="{Binding Name}"
                                                Margin="0,0,6,6" Cursor="Hand" FocusVisualStyle="{x:Null}">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="Ring" Width="36" Height="36" CornerRadius="18" BorderThickness="2" Padding="3"
                                                            BorderBrush="Transparent" Background="Transparent">
                                                        <Ellipse Fill="{Binding Fill}" />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Muted}" />
                                                        </Trigger>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Foreground}" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentText}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Button.Template>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Style="{StaticResource WheelSwatch}" Command="{Binding Settings.Picker.ToggleCommand}"
                                    ToolTip="{local:T AccentCustom}" AutomationProperties.Name="{local:T AccentCustom}" />
                        </StackPanel>

                        <!-- The wheel's panel: moving things here only previews; the theme changes on "Uygula" -->
                        <Border x:Name="AccentPickerPanel" Visibility="Collapsed" CornerRadius="12" Background="{DynamicResource ButtonSecondary}" Padding="16" Margin="0,4,0,6">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <local:ColorWheel Hue="{Binding Settings.Picker.Hue, Mode=TwoWay}" Saturation="{Binding Settings.Picker.Saturation, Mode=TwoWay}"
                                                      Brightness="{Binding Settings.Picker.Brightness}" VerticalAlignment="Top" Margin="0,0,22,0"
                                                      AutomationProperties.Name="{local:T AccentWheelName}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{local:T AccentBrightness}" Style="{StaticResource Caption}" />
                                        <Slider Style="{StaticResource BrightnessSlider}" Minimum="10" Maximum="100" SmallChange="2" LargeChange="10" Margin="0,4,0,0"
                                                Value="{Binding Settings.Picker.Brightness, Mode=TwoWay}" AutomationProperties.Name="{local:T AccentBrightness}" />
                                        <TextBlock Text="{local:T AccentHexCode}" Style="{StaticResource Caption}" Margin="0,12,0,6" />
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="40" Height="40" CornerRadius="10" Background="{Binding Settings.Picker.Preview}"
                                                    BorderBrush="{DynamicResource Divider}" BorderThickness="1" ToolTip="{local:T UiKullanilanRenk}" />
                                            <TextBox Text="{Binding Settings.Picker.Hex, UpdateSourceTrigger=PropertyChanged}" Width="118" MaxLength="7" Margin="10,0,0,0"
                                                     HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                                     AutomationProperties.Name="{local:T UiVurguRengiRrggbb}" ToolTip="{local:T UiRrggbbBicimindeBirRenk}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{local:T AccentPickNote}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,12,0,0" />
                                <TextBlock Text="{Binding Settings.Picker.Error}" Foreground="{DynamicResource StatusBad}" FontSize="12.5" Margin="0,6,0,0"
                                           TextWrapping="Wrap" Visibility="{Binding Settings.Picker.HasError, Converter={StaticResource BoolToVis}}" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                    <Button Content="{local:T AccentCancel}" Command="{Binding Settings.Picker.CloseCommand}" Style="{StaticResource SecondaryButton}"
                                            Background="{DynamicResource Raised}" AutomationProperties.Name="{local:T AccentCancel}" />
                                    <Button Content="{local:T AccentApply}" Command="{Binding Settings.Picker.ApplyCommand}" Style="{StaticResource PrimaryButton}"
                                            AutomationProperties.Name="{local:T AccentApply}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Button Content="{local:T UiVarsayilanRenk}" Command="{Binding Settings.ResetAccentCommand}" HorizontalAlignment="Left"
                                Style="{StaticResource SecondaryButton}" Margin="0,4,0,0" AutomationProperties.Name="{local:T UiVarsayilanRengeDon}" />

                        <CheckBox IsChecked="{Binding Settings.RecolorLogo}" Margin="0,18,0,0" HorizontalAlignment="Left"
                                  AutomationProperties.Name="{local:T UiLogoyuVePencereSimgesiniDeBu}">
                            <StackPanel>
                                <TextBlock Text="{local:T UiLogoyuVePencereSimgesiniDeBu}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap"
                                           Text="{local:T UiUygulamadakiLogoIleCalisirkenPence}" />
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Text="{Binding Settings.SaveError}" Foreground="{DynamicResource StatusBad}" Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Settings.HasSaveError, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <StackPanel>
                        <TextBlock Text="{local:T ExpTitle}" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="{local:T ExpIntro}" Style="{StaticResource Caption}" TextWrapping="Wrap" Margin="0,2,0,10" />
                        <CheckBox IsChecked="{Binding Settings.ExperimentalDevices}" HorizontalAlignment="Left" AutomationProperties.Name="{local:T ExpDevices}">
                            <StackPanel>
                                <TextBlock Text="{local:T ExpDevices}" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{local:T ExpDevicesText}" />
                            </StackPanel>
                        </CheckBox>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource Panel}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{local:T UiFoxfixIKaldir}" Style="{StaticResource SectionTitle}" />
                            <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                       Text="{local:T UiFoxdpiHizmetZamanlanmisGorevAyarla}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="{local:T UiFoxfixIKaldir}" Command="{Binding UninstallCommand}" Style="{StaticResource DangerButton}"
                                VerticalAlignment="Center" Margin="16,0,0,0" AutomationProperties.Name="{local:T UiFoxfixIKaldir}" />
                    </Grid>
                </Border>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>

    <!-- ============ SIDEBAR: the product, its places and FoxDPI's state, always in view ============ -->
    <Grid x:Name="SidebarHost" Grid.ColumnSpan="2" Width="232" HorizontalAlignment="Left">
    <Grid.RenderTransform>
        <TranslateTransform x:Name="SidebarShift" />
    </Grid.RenderTransform>
    <Border x:Name="Sidebar" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,0,1,0">
      <Grid>
        <DockPanel x:Name="SidebarContent" Margin="12,58,12,14">
            <StackPanel DockPanel.Dock="Bottom">
                <!-- FoxDPI's state, wherever the person is; a press opens its settings -->
                <Button Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.DnsDpi}"
                        AutomationProperties.Name="{local:T UiFoxdpiDurumuDnsVeDpiSayfasini}" ToolTip="{local:T UiDnsVeDpiSayfasiniAc}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}" />
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="16" Height="16" Margin="0,0,12,0" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource StatusNeutral}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Dpi.IsActive}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource StatusOk}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{local:T UiFoxDpiOff}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Dpi.IsActive}" Value="True">
                                            <Setter Property="Text" Value="{local:T UiFoxDpiOn}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource Divider}" Margin="4,8,4,8" />
                <StackPanel Orientation="Horizontal">
                    <Button Command="{Binding Info.OpenCommand}" Style="{StaticResource NavItem}" HorizontalAlignment="Left"
                            ToolTip="{local:T UiSurumYapimciVeKullanilanAcikKaynak}" AutomationProperties.Name="{local:T UiBilgi}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,9,0"
                                  Data="M8,1.5 A6.5,6.5 0 1 0 8,14.5 A6.5,6.5 0 1 0 8,1.5 M8,7 L8,11.2 M8,4.6 L8,4.7" />
                            <TextBlock Text="{local:T UiBilgi}" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ShareRepoCommand}" Style="{StaticResource NavItem}" Margin="4,0,0,0"
                            ToolTip="{local:T UiFoxfixInGithubBaglantisiniKopyala}" AutomationProperties.Name="{local:T UiBaglantiyiPaylas}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource NavIcon}" Margin="0,0,9,0"
                                  Data="M4,9 L4,13.5 L12,13.5 L12,9 M8,10 L8,2.5 M5.2,5.2 L8,2.4 L10.8,5.2" />
                            <TextBlock Text="{local:T UiPaylas}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" Margin="0,0,0,8">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="10,0,0,24">
                    <Image Source="{DynamicResource FoxLogoImage}" Height="36" RenderOptions.BitmapScalingMode="HighQuality"
                           AutomationProperties.Name="{local:T UiFoxfixLogosu}" />
                    <TextBlock Text="FoxFix" FontFamily="{StaticResource DisplayFont}" FontSize="22" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <Button x:Name="NavHome" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Home}" AutomationProperties.Name="{local:T UiGenelBakis}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsHome}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M2,8 L8,2.8 L14,8 M3.8,6.6 L3.8,13.5 L12.2,13.5 L12.2,6.6 M6.6,13.5 L6.6,9.6 L9.4,9.6 L9.4,13.5" />
                        <TextBlock Text="{local:T UiGenelBakis}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavConnection" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Connection}" AutomationProperties.Name="{local:T UiBaglantiKontrolu}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnection}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M1.5,8.5 L4.5,8.5 L6.4,3.5 L9.6,12.5 L11.5,8.5 L14.5,8.5" />
                        <TextBlock Text="{local:T UiBaglantiKontrolu}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavTweaks" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Tweaks}" AutomationProperties.Name="{local:T UiHizlandirmaVeAyarlar}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTweaks}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M2,4.5 L14,4.5 M2,11.5 L14,11.5 M5.5,2.5 L5.5,6.5 M10.5,9.5 L10.5,13.5" />
                        <TextBlock Text="{local:T UiHizlandirmaVeAyarlar}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavDnsDpi" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.DnsDpi}" AutomationProperties.Name="{local:T UiDnsVeDpi}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDnsDpi}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M8,1.8 L13.4,4 L13.4,8 C13.4,11.1 11,13.3 8,14.3 C5,13.3 2.6,11.1 2.6,8 L2.6,4 Z M5.6,8.1 L7.3,9.8 L10.5,6.4" />
                        <TextBlock Text="{local:T UiDnsVeDpi}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavAccess" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Access}" AutomationProperties.Name="{local:T UiErisimTesti}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsAccess}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M8,1.8 A6.2,6.2 0 1 0 8,14.2 A6.2,6.2 0 1 0 8,1.8 M1.8,8 L14.2,8 M8,1.8 C5.6,4.4 5.6,11.6 8,14.2 M8,1.8 C10.4,4.4 10.4,11.6 8,14.2" />
                        <TextBlock Text="{local:T UiErisimTesti}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavOverlay" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Overlay}" AutomationProperties.Name="{local:T OverlayNav}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsOverlay}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M2,12 A6,6 0 1 1 14,12 M8,12 L11,7.5 M3.2,12 L2,12 M14,12 L12.8,12 M8,5 L8,6.2" />
                        <TextBlock Text="{local:T OverlayNav}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavDevices" Visibility="{Binding Settings.ExperimentalDevices, Converter={StaticResource BoolToVis}}" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Devices}" AutomationProperties.Name="{local:T UiDevicesNav}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDevices}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M6,3.5 A2,2 0 0 1 10,3.5 L10,8 A2,2 0 0 1 6,8 Z M3.5,7.5 C3.5,10.2 5.5,11.8 8,11.8 C10.5,11.8 12.5,10.2 12.5,7.5 M8,11.8 L8,14.5 M5.5,14.5 L10.5,14.5" />
                        <TextBlock Text="{local:T UiDevicesNav}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavReport" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Report}" AutomationProperties.Name="{local:T UiRaporVeGecmis}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsReport}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M2.6,5.2 A6,6 0 1 1 2,8 M2.2,2.4 L2.6,5.4 L5.6,5.2 M8,4.8 L8,8.2 L10.4,9.8" />
                        <TextBlock Text="{local:T UiRaporVeGecmis}" />
                    </StackPanel>
                </Button>
                <Button x:Name="NavSettings" Command="{Binding OpenPageCommand}" CommandParameter="{x:Static local:AppPage.Settings}" AutomationProperties.Name="{local:T UiAyarlar}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSettings}" Value="True"><Setter Property="Tag" Value="active" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource NavIcon}" Data="M8,5.6 A2.4,2.4 0 1 0 8,10.4 A2.4,2.4 0 1 0 8,5.6 M8,1.5 L8,3.4 M8,12.6 L8,14.5 M1.5,8 L3.4,8 M12.6,8 L14.5,8 M3.4,3.4 L4.8,4.8 M11.2,11.2 L12.6,12.6 M3.4,12.6 L4.8,11.2 M11.2,4.8 L12.6,3.4" />
                        <TextBlock Text="{local:T UiAyarlar}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            </ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
    <!-- "Kopyalandı": appears above the share button, floats up and is gone -->
    <Border x:Name="ShareToast" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="96,0,0,58" Padding="11,6"
            CornerRadius="8" Background="{DynamicResource Raised}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
            Opacity="0" IsHitTestVisible="False">
        <Border.RenderTransform>
            <TranslateTransform x:Name="ShareToastShift" />
        </Border.RenderTransform>
        <StackPanel Orientation="Horizontal">
            <Path Width="12" Height="12" Stretch="Uniform" Data="M3,8.5 L6.5,12 L13,4.5" Stroke="{DynamicResource StatusOk}"
                  StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center" />
            <TextBlock Text="{local:T UiKopyalandi}" FontSize="13" Margin="7,0,0,0" />
        </StackPanel>
    </Border>
    </Grid>

    <!-- Three lines: fold the whole menu away (only these stay); press once more to bring it back -->
    <Button x:Name="SidebarToggle" WindowChrome.IsHitTestVisibleInChrome="True" Click="OnSidebarToggle" Style="{StaticResource IconButton}" Width="34" Height="34"
            Grid.ColumnSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12,14,0,0"
            ToolTip="{local:T UiMenuyuDaralt}" AutomationProperties.Name="{local:T UiMenuyuDaraltYaDaAc}">
        <Path Width="16" Height="16" Stretch="Uniform" Data="M2,4 L14,4 M2,8 L14,8 M2,12 L14,12"
              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.6"
              StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
    </Button>

    <!-- ============ CHANGES: preview, apply, result, restart (pop-up) ============ -->
    <Grid Grid.ColumnSpan="2" Visibility="{Binding Fix.IsPanelVisible, Converter={StaticResource BoolToVis}}"
          IsVisibleChanged="OnDialogVisibleChanged">
        <Border Background="{DynamicResource Scrim}" />
        <Border Style="{StaticResource DialogCard}" MaxWidth="580">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="620">
                <StackPanel>
                    <TextBlock Text="{local:T UiSuDegisikliklerYapilacak}" Style="{StaticResource SectionTitle}" FontSize="22"
                               Visibility="{Binding Fix.ShowConfirmation, Converter={StaticResource BoolToVis}}" />

                    <!-- While it runs: say so, so nobody thinks the app froze -->
                    <StackPanel Visibility="{Binding Fix.ShowBusyNote, Converter={StaticResource BoolToVis}}">
                        <TextBlock Style="{StaticResource SectionTitle}" FontSize="20" TextWrapping="Wrap"
                                   Text="{local:T UiYapilanIslemSuruyorLutfenBekleyini}" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <!-- When it is over: say plainly whether it worked -->
                    <StackPanel Orientation="Horizontal" Visibility="{Binding Fix.HasResultTitle, Converter={StaticResource BoolToVis}}">
                        <Path Width="18" Height="18" Stretch="Uniform" Data="M3,8.5 L6.5,12 L13,4.5" Stroke="{DynamicResource StatusOk}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" VerticalAlignment="Center"
                              Visibility="{Binding Fix.ResultSucceeded, Converter={StaticResource BoolToVis}}" />
                        <Path Width="18" Height="18" Stretch="Uniform" Data="M4.2,4.2 L11.8,11.8 M11.8,4.2 L4.2,11.8" Stroke="{DynamicResource StatusBad}"
                              StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" VerticalAlignment="Center"
                              Visibility="{Binding Fix.ResultSucceeded, Converter={StaticResource InverseBoolToVis}}" />
                        <TextBlock Text="{Binding Fix.ResultTitle}" Style="{StaticResource SectionTitle}" FontSize="22" Margin="10,0,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>

                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding Fix.ProgressPercent}" Height="6"
                                 IsIndeterminate="{Binding Fix.IsIndeterminate}" Margin="0,14,0,0"
                                 Visibility="{Binding Fix.IsBusy, Converter={StaticResource BoolToVis}}"
                                 AutomationProperties.Name="{local:T UiIslemIlerlemesi}" />
                    <TextBlock Text="{Binding Fix.ProgressText}" Style="{StaticResource Caption}" Margin="0,6,0,4"
                               AutomationProperties.LiveSetting="Off"
                               Visibility="{Binding Fix.HasProgressText, Converter={StaticResource BoolToVis}}" />

                    <ItemsControl ItemsSource="{Binding Fix.PreviewLines}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Text}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}"
                                               Margin="0,12,0,2" TextWrapping="Wrap"
                                               Visibility="{Binding IsHeader, Converter={StaticResource BoolToVis}}" />
                                    <TextBlock Text="{Binding Text, StringFormat='•  {0}'}" TextWrapping="Wrap" Margin="0,3"
                                               LineHeight="21"
                                               Visibility="{Binding IsBullet, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Visibility="{Binding Fix.ShowConfirmation, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Fix.AdminNote}" Foreground="{DynamicResource AccentText}"
                                   Margin="0,12,0,0" TextWrapping="Wrap"
                                   Visibility="{Binding Fix.HasAdminNote, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>

                    <TextBlock Text="{Binding Fix.Message}" TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="21"
                               Visibility="{Binding Fix.ShowPanelMessage, Converter={StaticResource BoolToVis}}" />

                    <!-- A finished change that needs a restart -->
                    <StackPanel Margin="0,18,0,0" Visibility="{Binding Fix.ShowRebootBanner, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{local:T UiYenidenBaslatmaGerekiyor}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        <TextBlock Style="{StaticResource BodyMuted}" Margin="0,4,0,0"
                                   Text="{local:T UiSurucununBellektenInmesiIcinBilgis}" />
                        <Button Content="{local:T UiSimdiYenidenBaslat}" Command="{Binding Fix.RestartNowCommand}"
                                Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.Name="{local:T UiSimdiYenidenBaslat}" />
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding Fix.RebootScheduled, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{local:T UiYenidenBaslatmaPlanlandi}" FontWeight="SemiBold" Foreground="{DynamicResource AccentText}" />
                        <Button Content="{local:T UiYenidenBaslatmayiIptalEt}" Command="{Binding Fix.CancelRestartCommand}"
                                Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="0,12,0,0"
                                AutomationProperties.Name="{local:T UiYenidenBaslatmayiIptalEt}" />
                    </StackPanel>

                    <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,6"
                            Visibility="{Binding Fix.ShowConfirmation, Converter={StaticResource BoolToVis}}" />

                    <CheckBox Content="{local:T UiYukaridakiDegisiklikleriOkudumOnay}"
                              IsChecked="{Binding Fix.IsConfirmed}"
                              AutomationProperties.Name="{local:T UiDegisiklikleriOnayliyorum}"
                              Visibility="{Binding Fix.ShowConfirmation, Converter={StaticResource BoolToVis}}" />

                    <CheckBox IsChecked="{Binding Fix.AutoRestart}"
                              AutomationProperties.Name="{local:T UiKendiligindenYenidenBaslatTavsiyeE}"
                              Visibility="{Binding Fix.ShowAutoRestartOption, Converter={StaticResource BoolToVis}}">
                        <TextBlock TextWrapping="Wrap">
                            <Run Text="{local:T UiIslemlerdenSonraYenidenBaslat}" />
                            <Run Text="{local:T UiTavsiyeEdilen}" FontSize="11.5" Foreground="{DynamicResource StatusBad}" />
                        </TextBlock>
                    </CheckBox>

                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="{Binding Fix.ApplyLabel}" Command="{Binding Fix.ApplyCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Visibility="{Binding Fix.ShowConfirmation, Converter={StaticResource BoolToVis}}" />
                        <Button Content="{local:T UiKapat}" Command="{Binding Fix.CancelCommand}"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>

    <!-- ============ MESSAGE (pop-up) ============ -->
