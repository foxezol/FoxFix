                               TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                </Grid>
                <TextBlock Text="{local:T DpiHintText}" TextWrapping="Wrap" LineHeight="22" Margin="0,16,0,0" />
                <Button Content="{local:T DpiHintOk}" Command="{Binding Onboarding.CloseDpiHintCommand}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,20,0,0" AutomationProperties.Name="{local:T DpiHintOk}" />
            </StackPanel>
        </Border>
    </Grid>

    <!-- ============ LANGUAGE CHANGED: REOPEN (pop-up) ============ -->
    <Grid Grid.ColumnSpan="2" Visibility="{Binding Settings.IsRestartPromptOpen, Converter={StaticResource BoolToVis}}"
          IsVisibleChanged="OnDialogVisibleChanged">
        <Border Background="{DynamicResource Scrim}" />
        <Border Style="{StaticResource DialogCard}" MaxWidth="460">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <StackPanel>
                <TextBlock Text="{local:T LangRestartTitle}" Style="{StaticResource SectionTitle}" FontSize="20" AutomationProperties.LiveSetting="Assertive" />
                <TextBlock Text="{local:T LangRestartText}" TextWrapping="Wrap" LineHeight="22" Margin="0,12,0,0" />
                <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                    <Button Content="{local:T UiRestartNow}" Command="{Binding Settings.RestartNowCommand}" Style="{StaticResource PrimaryButton}"
                            AutomationProperties.Name="{local:T UiRestartNow}" />
                    <Button Content="{local:T UiRestartLater}" Command="{Binding Settings.RestartLaterCommand}" Style="{StaticResource SecondaryButton}"
                            AutomationProperties.Name="{local:T UiRestartLater}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>

    <!-- ============ TOUR: the window is dimmed, one element stays lit, a small card says what it is ============ -->
    <Grid x:Name="TourLayer" Grid.ColumnSpan="2" Visibility="Collapsed" SizeChanged="OnTourLayerSizeChanged">
        <Path x:Name="TourShade" Fill="{DynamicResource Scrim}" />
        <Border x:Name="TourRing" HorizontalAlignment="Left" VerticalAlignment="Top" BorderBrush="{DynamicResource AccentText}" BorderThickness="2"
                CornerRadius="10" IsHitTestVisible="False" Opacity="0" />
        <Border x:Name="TourCard" Style="{StaticResource DialogCard}" Width="360" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0"
                RenderTransformOrigin="0.5,0.5" AutomationProperties.Name="{local:T TourDialogName}">
            <Border.RenderTransform>
                <ScaleTransform />
            </Border.RenderTransform>
            <StackPanel x:Name="TourBody">
                <StackPanel.RenderTransform>
                    <TranslateTransform />
                </StackPanel.RenderTransform>
                <TextBlock Text="{Binding Onboarding.Tour.StepText}" Style="{StaticResource Caption}" />
                <TextBlock Text="{Binding Onboarding.Tour.Title}" Style="{StaticResource SectionTitle}" FontSize="19" Margin="0,4,0,0"
                           AutomationProperties.LiveSetting="Assertive" AutomationProperties.HeadingLevel="Level2" />
                <TextBlock Text="{Binding Onboarding.Tour.Text}" TextWrapping="Wrap" LineHeight="21" Margin="0,10,0,0" />
                <Grid Margin="0,18,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Content="{local:T TourSkip}" Command="{Binding Onboarding.Tour.SkipCommand}" Style="{StaticResource GhostButton}"
                            HorizontalAlignment="Left" Margin="-10,0,0,0" AutomationProperties.Name="{local:T TourSkip}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{local:T TourBack}" Command="{Binding Onboarding.Tour.BackCommand}" Style="{StaticResource SecondaryButton}"
                                AutomationProperties.Name="{local:T TourBack}" />
                        <Button x:Name="TourNextButton" Command="{Binding Onboarding.Tour.NextCommand}" Style="{StaticResource PrimaryButton}" Margin="0">
                            <Button.Content>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{local:T TourNext}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Onboarding.Tour.IsLast}" Value="True"><Setter Property="Text" Value="{local:T TourFinish}" /></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Button.Content>
                        </Button>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>

</Grid>
    <!-- No title bar at all: only the three buttons float in the top right corner; the top strip still drags the window -->
    <StackPanel x:Name="TitleBarHost" Grid.RowSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Click="OnMinimize" AutomationProperties.Name="{local:T UiMinimize}" ToolTip="{local:T UiMinimize}" />
        <Button x:Name="MaximizeButton" Content="&#xE922;" Style="{StaticResource CaptionButton}" Click="OnMaximizeRestore"
                AutomationProperties.Name="{local:T UiMaximize}" ToolTip="{local:T UiMaximize}" />
        <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Click="OnCloseWindow" AutomationProperties.Name="{local:T UiCloseWindow}" ToolTip="{local:T UiCloseWindow}" />
    </StackPanel>
    </Grid>
</Window>
