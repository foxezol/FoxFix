                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Made by foxezol, Claude Code" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Command="{Binding OpenFeedbackCommand}" Style="{StaticResource IconButton}"
                            ToolTip="Geri bildirim: Discord profilime ulaş" AutomationProperties.Name="Geri bildirim gönder">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="15" Height="15" Stretch="Uniform" Data="M2,3 L14,3 L14,10.5 L8,10.5 L5,13.5 L5,10.5 L2,10.5 Z"
                                  Stroke="{DynamicResource Muted}" StrokeThickness="1.5" StrokeLineJoin="Round" />
                            <TextBlock Text="Geri bildirim" Style="{StaticResource BodyMuted}" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>                <Button Content="Kapat" Command="{Binding Info.CloseCommand}" Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Left" Margin="0,22,0,0" AutomationProperties.Name="Kapat" />
            </StackPanel>
        </Border>
