<Window x:Class="FoxFix.App.FoxDpiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FoxFix.App"
        Title="FoxDPI" Width="400" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="Assets/FoxDpi.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="0" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Grid>
    <!-- No Windows title bar: the whole top strip drags the window; only minimise and close are shown -->
    <StackPanel Margin="26,22,26,22">
        <StackPanel Orientation="Horizontal">
            <!-- A calm pulse says "running" without anyone having to read it -->
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource StatusOk}" RenderTransformOrigin="0.5,0.5" Opacity="0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="2.4" Duration="0:0:1.8" />
                                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="2.4" Duration="0:0:1.8" />
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse Fill="{DynamicResource StatusOk}" Width="10" Height="10" />
            </Grid>
            <TextBlock Text="{local:T UiFoxdpiAktif}" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                       Margin="14,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TextBlock Style="{StaticResource BodyMuted}" Margin="30,8,0,0" TextWrapping="Wrap">
            <Run Text="{local:T UiAyar}" />
            <Run Text="{Binding ProfileTitle, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Content="{local:T UiFoxfixIAc}" Command="{Binding OpenFoxFixCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="{local:T UiFoxfixIAc}" />
            <Button Content="{local:T UiDpiAyarlari2}" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0" AutomationProperties.Name="{local:T UiDpiAyarlari}" />
        </StackPanel>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
        <Button Content="&#xE921;" Style="{StaticResource CaptionButton}" Height="34" Click="OnMinimize" AutomationProperties.Name="{local:T UiMinimize}" ToolTip="{local:T UiMinimize}" />
        <Button Content="&#xE8BB;" Style="{StaticResource CaptionCloseButton}" Height="34" Click="OnCloseWindow" AutomationProperties.Name="{local:T UiCloseWindow}" ToolTip="{local:T UiCloseWindow}" />
    </StackPanel>
    </Grid>
</Window>