<Window x:Class="FoxFix.App.FoxDpiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxDPI" Width="400" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="Assets/FoxDpi.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <StackPanel Margin="28,26,28,26">
        <StackPanel Orientation="Horizontal">
            <!-- A calm pulse says "running" without anyone having to read it -->
            <Grid Width="16" Height="16" VerticalAlignment="Center">
                <Ellipse Fill="{DynamicResource StatusOk}" RenderTransformOrigin="0.5,0.5" Opacity="0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="PulseScale" />
                    </Ellipse.RenderTransform>
                    <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                            <BeginStoryboard>
                                <Storyboard RepeatBehavior="Forever">
                                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleX" From="1" To="2.4" Duration="0:0:1.8" />
                                    <DoubleAnimation Storyboard.TargetName="PulseScale" Storyboard.TargetProperty="ScaleY" From="1" To="2.4" Duration="0:0:1.8" />
                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.5" To="0" Duration="0:0:1.8" />
                                </Storyboard>
                            </BeginStoryboard>
                        </EventTrigger>
                    </Ellipse.Triggers>
                </Ellipse>
                <Ellipse Fill="{DynamicResource StatusOk}" Width="10" Height="10" />
            </Grid>
            <TextBlock Text="FoxDPI aktif" FontFamily="{StaticResource DisplayFont}" FontSize="24" FontWeight="SemiBold"
                       Margin="14,0,0,0" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
        <TextBlock Style="{StaticResource BodyMuted}" Margin="30,8,0,0" TextWrapping="Wrap">
            <Run Text="Ayar:" />
            <Run Text="{Binding ProfileTitle, Mode=OneWay}" />
        </TextBlock>
        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
            <Button Content="FoxFix'i aç" Command="{Binding OpenFoxFixCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="FoxFix'i aç" />
            <Button Content="DPI Ayarları" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0" AutomationProperties.Name="DPI ayarları" />
        </StackPanel>
    </StackPanel>
</Window>