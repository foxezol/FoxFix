<Window x:Class="FoxFix.App.FoxDpiWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FoxDPI" Width="420" SizeToContent="Height" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
        Icon="Assets/FoxDpi.ico"
        Background="{DynamicResource Background}" Foreground="{DynamicResource Foreground}"
        FontFamily="{StaticResource UiFont}" FontSize="14"
        TextOptions.TextFormattingMode="Display">
    <!-- The small window that is FoxDPI while it runs: what it is, that it runs, with which setting, and how to stop it -->
    <StackPanel Margin="24,22,24,22">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Image Source="{DynamicResource FoxDpiLogoImage}" Height="40" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="FoxDPI logosu" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="FoxDPI" Style="{StaticResource PageTitle}" FontSize="24" />
                <TextBlock Style="{StaticResource Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                    <Run Text="Ayar:" />
                    <Run Text="{Binding ProfileTitle, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
            <Border Grid.Column="2" Background="{DynamicResource OkSoft}" CornerRadius="12" Padding="10,4" VerticalAlignment="Center" Margin="12,0,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Fill="{DynamicResource StatusOk}" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,7,0" />
                    <TextBlock Text="Çalışıyor" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusOk}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Height="1" Background="{DynamicResource Divider}" Margin="0,18,0,14" />
        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                   Text="Bu pencereyi kapattığınızda FoxDPI durur ve sürücüsü bellekten kalkar. Hile önleme sistemi olan bir oyunu açmadan önce kapatın." />

        <WrapPanel Margin="0,16,0,0">
            <Button Content="FoxFix'i aç" Command="{Binding OpenFoxFixCommand}" Style="{StaticResource SecondaryButton}" AutomationProperties.Name="FoxFix'i aç" />
            <Button Content="DPI ayarları" Command="{Binding OpenSettingsCommand}" Style="{StaticResource SecondaryButton}" Margin="0" AutomationProperties.Name="DPI ayarları" />
        </WrapPanel>
    </StackPanel>
</Window>
