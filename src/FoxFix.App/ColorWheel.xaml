<UserControl x:Class="FoxFix.App.ColorWheel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="180" Height="180" Cursor="Cross" Focusable="False">
    <Grid x:Name="Surface" Background="Transparent"
          MouseLeftButtonDown="OnSurfaceMouseDown" MouseMove="OnSurfaceMouseMove" MouseLeftButtonUp="OnSurfaceMouseUp">
        <Image x:Name="WheelImage" Stretch="Fill" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" />
        <Canvas IsHitTestVisible="False">
            <!-- The pointer: a dark ring outside a light one, filled with the colour picked -->
            <Ellipse x:Name="ThumbOuter" Width="24" Height="24" Fill="#59000000" />
            <Ellipse x:Name="Thumb" Width="20" Height="20" Stroke="White" StrokeThickness="3" />
        </Canvas>
    </Grid>
</UserControl>
